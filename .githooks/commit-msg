#!/bin/sh
set -eu

message_file=$1
branch_name=$(git symbolic-ref --quiet --short HEAD) || exit 0

# 팀 브랜치 형식: feat/S15P31A305-123-task-name
issue_key=$(printf '%s\n' "$branch_name" |
    sed -nE 's@^([^/]+/)?(S15P31A305-[1-9][0-9]*)(-.*)?$@\2@p')

if [ -z "$issue_key" ]; then
    exit 0
fi

# 병합·체리픽·리베이스에서는 원래 커밋의 메시지를 유지한다.
for operation_path in MERGE_HEAD CHERRY_PICK_HEAD rebase-merge rebase-apply; do
    if [ -e "$(git rev-parse --git-path "$operation_path")" ]; then
        exit 0
    fi
done

commit_title=$(sed -n '1p' "$message_file")

case "$commit_title" in
    ''|'Merge '*|'Revert '*|'fixup! '*|'squash! '*|'amend! '*)
        exit 0
        ;;
esac

# 직접 적은 이슈 키는 다른 작업을 참조하려는 의도일 수 있어 변경하지 않는다.
if printf '%s\n' "$commit_title" |
    grep -Eq '(^|[^[:alnum:]_])[A-Z][A-Z0-9_]*-[0-9]+([^[:alnum:]_]|$)'; then
    exit 0
fi

temporary_file=$(mktemp "${message_file}.XXXXXX")
trap 'rm -f "$temporary_file"' EXIT

awk -v issue_key="$issue_key" '
    NR == 1 {
        sub(/\r$/, "")

        sub(/[[:space:]]*$/, "")
        print $0 " [" issue_key "]"
        next
    }

    { print }
' "$message_file" > "$temporary_file"

cat "$temporary_file" > "$message_file"
