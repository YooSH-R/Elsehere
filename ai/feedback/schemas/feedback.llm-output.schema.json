{
  "$defs": {
    "Communication": {
      "additionalProperties": false,
      "properties": {
        "judgement": {
          "enum": [
            "clear",
            "partially_clear",
            "unclear",
            "not_assessable"
          ],
          "title": "Judgement",
          "type": "string"
        },
        "explanation_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation Ko",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "judgement",
        "explanation_ko",
        "evidence"
      ],
      "title": "Communication",
      "type": "object"
    },
    "ConversationSummary": {
      "additionalProperties": false,
      "properties": {
        "text_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text Ko",
          "type": "string"
        },
        "evidence": {
          "description": "이번 대화의 확정 사용자/NPC 발화. NPC 인용은 문맥 요약에만 허용.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "text_ko",
        "evidence"
      ],
      "title": "ConversationSummary",
      "type": "object"
    },
    "DataIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "NO_USABLE_USER_TURNS",
            "INSUFFICIENT_CONTEXT",
            "AMBIGUOUS_INPUT"
          ],
          "title": "Code",
          "type": "string"
        },
        "message_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message Ko",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message_ko"
      ],
      "title": "DataIssue",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "description": "현재 요청 대화의 발화 ID.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Turn Id",
          "type": "string"
        },
        "quote": {
          "description": "해당 final_text에 정확히 포함된 인용. 수정 전 STT 텍스트를 근거로 삼지 않는다.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FeedbackData": {
      "additionalProperties": false,
      "properties": {
        "conversation_summary": {
          "$ref": "#/$defs/ConversationSummary"
        },
        "communication": {
          "$ref": "#/$defs/Communication"
        },
        "review_tags": {
          "description": "이번 UI 계약의 제안 상한 3개. 근거 없으면 빈 배열. 공식 평가 척도가 아니다.",
          "items": {
            "$ref": "#/$defs/ReviewTag"
          },
          "maxItems": 3,
          "title": "Review Tags",
          "type": "array"
        },
        "turn_reviews": {
          "items": {
            "$ref": "#/$defs/TurnReview"
          },
          "minItems": 1,
          "title": "Turn Reviews",
          "type": "array"
        },
        "summary_suggestion_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Summary Suggestion Id"
        },
        "vocab_candidates": {
          "items": {
            "$ref": "#/$defs/VocabCandidate"
          },
          "title": "Vocab Candidates",
          "type": "array"
        },
        "situation_expressions": {
          "items": {
            "$ref": "#/$defs/SituationExpression"
          },
          "maxItems": 3,
          "title": "Situation Expressions",
          "type": "array"
        }
      },
      "required": [
        "conversation_summary",
        "communication",
        "review_tags",
        "turn_reviews",
        "summary_suggestion_id",
        "vocab_candidates"
      ],
      "title": "FeedbackData",
      "type": "object"
    },
    "LlmInsufficient": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "const": "insufficient_evidence",
          "title": "Outcome",
          "type": "string"
        },
        "result": {
          "title": "Result",
          "type": "null"
        },
        "problem": {
          "$ref": "#/$defs/DataIssue"
        },
        "spoken_usage_selection": {
          "default": null,
          "title": "Spoken Usage Selection",
          "type": "null"
        }
      },
      "required": [
        "outcome",
        "result",
        "problem"
      ],
      "title": "LlmInsufficient",
      "type": "object"
    },
    "LlmUsable": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "const": "usable",
          "title": "Outcome",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/FeedbackData"
        },
        "problem": {
          "title": "Problem",
          "type": "null"
        },
        "spoken_usage_selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpokenUsageSelection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "outcome",
        "result",
        "problem"
      ],
      "title": "LlmUsable",
      "type": "object"
    },
    "ReviewTag": {
      "additionalProperties": false,
      "properties": {
        "tag_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Tag Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "strength",
            "improvement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label Ko",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "assisted": {
          "title": "Assisted",
          "type": "boolean"
        }
      },
      "required": [
        "tag_id",
        "kind",
        "label_ko",
        "evidence",
        "assisted"
      ],
      "title": "ReviewTag",
      "type": "object"
    },
    "SituationExpression": {
      "additionalProperties": false,
      "description": "이번 장면에서 자주 쓰는 관용·추천 표현. 사용자 발화 평가와 별개로, 다음에 같은 상황에서 써 볼 표현을 알려 준다.",
      "properties": {
        "expression": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Expression",
          "type": "string"
        },
        "meaning_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Meaning Ko",
          "type": "string"
        },
        "usage_ko": {
          "description": "이 장면에서 언제 쓰는지 한 문장",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Usage Ko",
          "type": "string"
        },
        "example_en": {
          "description": "학습용 새 예문. 실제 사용자 발화라고 표시하지 않는다.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Example En",
          "type": "string"
        },
        "example_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Example Ko",
          "type": "string"
        }
      },
      "required": [
        "expression",
        "meaning_ko",
        "usage_ko",
        "example_en",
        "example_ko"
      ],
      "title": "SituationExpression",
      "type": "object"
    },
    "SpokenUsageSelection": {
      "additionalProperties": false,
      "properties": {
        "catalog_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Catalog Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Turn Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "catalog_id",
        "turn_id",
        "quote"
      ],
      "title": "SpokenUsageSelection",
      "type": "object"
    },
    "Suggestion": {
      "additionalProperties": false,
      "properties": {
        "suggestion_id": {
          "description": "결과 내부 ID. DB 식별자가 아니다.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Suggestion Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "grammar_error",
            "vocabulary_error",
            "natural_alternative",
            "context_fit",
            "idiomatic_expression"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Evidence"
        },
        "suggested_expression": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Suggested Expression",
          "type": "string"
        },
        "explanation_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation Ko",
          "type": "string"
        }
      },
      "required": [
        "suggestion_id",
        "kind",
        "source",
        "suggested_expression",
        "explanation_ko"
      ],
      "title": "Suggestion",
      "type": "object"
    },
    "SuggestionSource": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "suggestion",
          "title": "Type",
          "type": "string"
        },
        "review_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Review Id",
          "type": "string"
        },
        "suggestion_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Suggestion Id",
          "type": "string"
        },
        "quote": {
          "description": "연결된 suggested_expression에 포함된 실제 표현.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "type",
        "review_id",
        "suggestion_id",
        "quote"
      ],
      "title": "SuggestionSource",
      "type": "object"
    },
    "TurnReview": {
      "additionalProperties": false,
      "properties": {
        "review_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Review Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Turn Id",
          "type": "string"
        },
        "original_text": {
          "description": "해당 사용자 final_text 전체와 정확히 일치.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Original Text",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "appropriate",
            "improvement_suggested",
            "needs_clarification",
            "not_assessable"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "explanation_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation Ko",
          "type": "string"
        },
        "assisted": {
          "title": "Assisted",
          "type": "boolean"
        },
        "suggestions": {
          "items": {
            "$ref": "#/$defs/Suggestion"
          },
          "title": "Suggestions",
          "type": "array"
        }
      },
      "required": [
        "review_id",
        "turn_id",
        "original_text",
        "verdict",
        "explanation_ko",
        "assisted",
        "suggestions"
      ],
      "title": "TurnReview",
      "type": "object"
    },
    "UserTurnSource": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "user_turn",
          "title": "Type",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Turn Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "type",
        "turn_id",
        "quote"
      ],
      "title": "UserTurnSource",
      "type": "object"
    },
    "VocabCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "word",
            "idiom",
            "sentence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "expression": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Expression",
          "type": "string"
        },
        "meaning_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Meaning Ko",
          "type": "string"
        },
        "example_en": {
          "description": "학습용 예문. 실제 사용자 발화라고 표시하지 않는다.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Example En",
          "type": "string"
        },
        "example_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Example Ko",
          "type": "string"
        },
        "source": {
          "discriminator": {
            "mapping": {
              "suggestion": "#/$defs/SuggestionSource",
              "user_turn": "#/$defs/UserTurnSource"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UserTurnSource"
            },
            {
              "$ref": "#/$defs/SuggestionSource"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "candidate_id",
        "kind",
        "expression",
        "meaning_ko",
        "example_en",
        "example_ko",
        "source"
      ],
      "title": "VocabCandidate",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "insufficient_evidence": "#/$defs/LlmInsufficient",
      "usable": "#/$defs/LlmUsable"
    },
    "propertyName": "outcome"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/LlmUsable"
    },
    {
      "$ref": "#/$defs/LlmInsufficient"
    }
  ]
}
