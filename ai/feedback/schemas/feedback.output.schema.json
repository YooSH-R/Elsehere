          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Evidence"
        },
        "suggested_expression": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Suggested Expression",
          "type": "string"
        },
        "explanation_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation Ko",
          "type": "string"
        }
      },
      "required": [
        "suggestion_id",
        "kind",
        "source",
        "suggested_expression",
        "explanation_ko"
      ],
      "title": "Suggestion",
      "type": "object"
    },
    "SuggestionSource": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "suggestion",
          "title": "Type",
          "type": "string"
        },
        "review_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Review Id",
          "type": "string"
        },
        "suggestion_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Suggestion Id",
          "type": "string"
        },
        "quote": {
          "description": "연결된 suggested_expression에 포함된 실제 표현.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "type",
        "review_id",
        "suggestion_id",
        "quote"
      ],
      "title": "SuggestionSource",
      "type": "object"
    },
    "TurnReview": {
      "additionalProperties": false,
      "properties": {
        "review_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Review Id",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Turn Id",
          "type": "string"
        },
        "original_text": {
          "description": "해당 사용자 final_text 전체와 정확히 일치.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Original Text",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "appropriate",
            "improvement_suggested",
            "needs_clarification",
            "not_assessable"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "explanation_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation Ko",
          "type": "string"
        },
        "assisted": {
          "title": "Assisted",
          "type": "boolean"
        },
        "suggestions": {
          "items": {
            "$ref": "#/$defs/Suggestion"
          },
          "title": "Suggestions",
          "type": "array"
        },
        "expression_examples": {
          "items": {
            "$ref": "#/$defs/ExpressionExample"
          },
          "maxItems": 3,
          "title": "Expression Examples",
          "type": "array"
        }
      },
      "required": [
        "review_id",
        "turn_id",
        "original_text",
        "verdict",
        "explanation_ko",
        "assisted",
        "suggestions"
      ],
      "title": "TurnReview",
      "type": "object"
    },
    "UserTurnSource": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "user_turn",
          "title": "Type",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Turn Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "type",
        "turn_id",
        "quote"
      ],
      "title": "UserTurnSource",
      "type": "object"
    },
    "VocabCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Candidate Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "word",
            "idiom",
            "sentence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "expression": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Expression",
          "type": "string"
        },
        "meaning_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Meaning Ko",
          "type": "string"
        },
        "example_en": {
          "description": "학습용 예문. 실제 사용자 발화라고 표시하지 않는다.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Example En",
          "type": "string"
        },
        "example_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Example Ko",
          "type": "string"
        },
        "source": {
          "discriminator": {
            "mapping": {
              "suggestion": "#/$defs/SuggestionSource",
              "user_turn": "#/$defs/UserTurnSource"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/UserTurnSource"
            },
            {
              "$ref": "#/$defs/SuggestionSource"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "candidate_id",
        "kind",
        "expression",
        "meaning_ko",
        "example_en",
        "example_ko",
        "source"
      ],
      "title": "VocabCandidate",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "blocked_by_quota": "#/$defs/QuotaBlocked",
      "completed": "#/$defs/Completed",
      "failed": "#/$defs/Failed",
      "insufficient_evidence": "#/$defs/Insufficient",
      "processing": "#/$defs/Processing"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Completed"
    },
    {
      "$ref": "#/$defs/Processing"
    },
    {
      "$ref": "#/$defs/Insufficient"
    },
    {
      "$ref": "#/$defs/QuotaBlocked"
    },
    {
      "$ref": "#/$defs/Failed"
    }
  ]
}
