        },
        "analysis_config_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Analysis Config Version",
          "type": "string"
        },
        "status": {
          "const": "processing",
          "title": "Status",
          "type": "string"
        },
        "result": {
          "title": "Result",
          "type": "null"
        },
        "problem": {
          "title": "Problem",
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "scope",
        "conversation_revision",
        "analysis_config_version",
        "status",
        "result",
        "problem"
      ],
      "title": "Processing",
      "type": "object"
    },
    "QuotaBlocked": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "conversation_revision": {
          "minimum": 0,
          "title": "Conversation Revision",
          "type": "integer"
        },
        "analysis_config_version": {
          "maxLength": 128,
          "minLength": 1,
