        "message_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message Ko",
          "type": "string"
        },
        "retryable_now": {
          "title": "Retryable Now",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message_ko",
        "retryable_now"
      ],
      "title": "ModelIssue",
      "type": "object"
    },
    "Processing": {
      "additionalProperties": false,
      "properties": {
