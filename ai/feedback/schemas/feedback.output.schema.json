          "const": "0.3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "conversation_revision": {
          "minimum": 0,
          "title": "Conversation Revision",
