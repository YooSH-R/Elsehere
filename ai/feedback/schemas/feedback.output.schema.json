        },
        "message_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message Ko",
          "type": "string"
        },
        "retryable_now": {
          "const": false,
          "title": "Retryable Now",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message_ko",
        "retryable_now"
      ],
      "title": "QuotaIssue",
      "type": "object"
    },
    "ReviewTag": {
      "additionalProperties": false,
      "properties": {
        "tag_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Tag Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "strength",
            "improvement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label Ko",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "assisted": {
          "title": "Assisted",
          "type": "boolean"
        }
      },
      "required": [
        "tag_id",
        "kind",
        "label_ko",
        "evidence",
        "assisted"
      ],
      "title": "ReviewTag",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "description": "서버가 인증·확인한 사용자 ID. LLM이 생성하거나 선택하지 않는다.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "User Id",
          "type": "string"
        },
        "npc_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Npc Id",
          "type": "string"
        },
        "conversation_id": {
          "description": "특정 NPC와의 1회 대화. 로그인 세션과 구분한다.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Conversation Id",
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "npc_id",
        "conversation_id"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SituationExpression": {
      "additionalProperties": false,
      "description": "이번 장면에서 자주 쓰는 관용·추천 표현. 사용자 발화 평가와 별개로, 다음에 같은 상황에서 써 볼 표현을 알려 준다.",
      "properties": {
        "expression": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Expression",
          "type": "string"
        },
        "meaning_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Meaning Ko",
          "type": "string"
        },
        "usage_ko": {
          "description": "이 장면에서 언제 쓰는지 한 문장",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Usage Ko",
          "type": "string"
        },
        "example_en": {
          "description": "학습용 새 예문. 실제 사용자 발화라고 표시하지 않는다.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Example En",
          "type": "string"
        },
        "example_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Example Ko",
          "type": "string"
        }
      },
      "required": [
        "expression",
        "meaning_ko",
        "usage_ko",
        "example_en",
        "example_ko"
      ],
      "title": "SituationExpression",
      "type": "object"
    },
    "SpokenUsageNote": {
      "additionalProperties": false,
      "properties": {
        "catalog_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Catalog Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Evidence"
        },
        "expression": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Expression",
          "type": "string"
        },
        "meaning_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Meaning Ko",
          "type": "string"
        },
        "usage_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Usage Ko",
          "type": "string"
        },
        "example_en": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Example En",
          "type": "string"
        },
        "example_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Example Ko",
          "type": "string"
        },
        "example_kind": {
          "const": "learning_example",
          "title": "Example Kind",
          "type": "string"
        },
        "sources": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "catalog_id",
        "source",
        "expression",
        "meaning_ko",
        "usage_ko",
        "example_en",
        "example_ko",
        "example_kind",
        "sources"
      ],
      "title": "SpokenUsageNote",
      "type": "object"
    },
    "Suggestion": {
      "additionalProperties": false,
      "properties": {
        "suggestion_id": {
          "description": "결과 내부 ID. DB 식별자가 아니다.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Suggestion Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "grammar_error",
            "vocabulary_error",
            "natural_alternative",
            "context_fit",
