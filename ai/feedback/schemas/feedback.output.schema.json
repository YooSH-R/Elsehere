{
  "$defs": {
    "Communication": {
      "additionalProperties": false,
      "properties": {
        "judgement": {
          "enum": [
            "clear",
            "partially_clear",
            "unclear",
            "not_assessable"
          ],
          "title": "Judgement",
          "type": "string"
        },
        "explanation_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation Ko",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "judgement",
        "explanation_ko",
        "evidence"
      ],
      "title": "Communication",
      "type": "object"
    },
    "Completed": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "conversation_revision": {
          "minimum": 0,
          "title": "Conversation Revision",
          "type": "integer"
        },
        "analysis_config_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Analysis Config Version",
          "type": "string"
        },
        "status": {
          "const": "completed",
          "title": "Status",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/EnrichedFeedbackData"
        },
        "problem": {
          "title": "Problem",
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "scope",
        "conversation_revision",
        "analysis_config_version",
        "status",
        "result",
        "problem"
      ],
      "title": "Completed",
      "type": "object"
    },
    "ConversationSummary": {
      "additionalProperties": false,
      "properties": {
        "text_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text Ko",
          "type": "string"
        },
        "evidence": {
          "description": "이번 대화의 확정 사용자/NPC 발화. NPC 인용은 문맥 요약에만 허용.",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "text_ko",
        "evidence"
      ],
      "title": "ConversationSummary",
      "type": "object"
    },
    "DataIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "NO_USABLE_USER_TURNS",
            "INSUFFICIENT_CONTEXT",
            "AMBIGUOUS_INPUT"
          ],
          "title": "Code",
          "type": "string"
        },
        "message_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message Ko",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message_ko"
      ],
      "title": "DataIssue",
      "type": "object"
    },
    "EnrichedFeedbackData": {
      "additionalProperties": false,
      "properties": {
        "conversation_summary": {
          "$ref": "#/$defs/ConversationSummary"
        },
        "communication": {
          "$ref": "#/$defs/Communication"
        },
        "review_tags": {
          "description": "이번 UI 계약의 제안 상한 3개. 근거 없으면 빈 배열. 공식 평가 척도가 아니다.",
          "items": {
            "$ref": "#/$defs/ReviewTag"
          },
          "maxItems": 3,
          "title": "Review Tags",
          "type": "array"
        },
        "turn_reviews": {
          "items": {
            "$ref": "#/$defs/TurnReview"
          },
          "minItems": 1,
          "title": "Turn Reviews",
          "type": "array"
        },
        "summary_suggestion_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Summary Suggestion Id"
        },
        "vocab_candidates": {
          "items": {
            "$ref": "#/$defs/VocabCandidate"
          },
          "title": "Vocab Candidates",
          "type": "array"
        },
        "situation_expressions": {
          "items": {
            "$ref": "#/$defs/SituationExpression"
          },
          "maxItems": 3,
          "title": "Situation Expressions",
          "type": "array"
        },
        "spoken_usage_notes": {
          "items": {
            "$ref": "#/$defs/SpokenUsageNote"
          },
          "maxItems": 1,
          "title": "Spoken Usage Notes",
          "type": "array"
        }
      },
      "required": [
        "conversation_summary",
        "communication",
        "review_tags",
        "turn_reviews",
        "summary_suggestion_id",
        "vocab_candidates"
      ],
      "title": "EnrichedFeedbackData",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "description": "현재 요청 대화의 발화 ID.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Turn Id",
          "type": "string"
        },
        "quote": {
          "description": "해당 final_text에 정확히 포함된 인용. 수정 전 STT 텍스트를 근거로 삼지 않는다.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExpressionExample": {
      "additionalProperties": false,
      "properties": {
        "condition_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Condition Ko",
          "type": "string"
        },
        "expression": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Expression",
          "type": "string"
        },
        "meaning_ko": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Meaning Ko",
          "type": "string"
        }
      },
      "required": [
        "condition_ko",
        "expression",
        "meaning_ko"
      ],
      "title": "ExpressionExample",
      "type": "object"
    },
    "Failed": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "conversation_revision": {
          "minimum": 0,
          "title": "Conversation Revision",
          "type": "integer"
        },
        "analysis_config_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Analysis Config Version",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "result": {
          "title": "Result",
          "type": "null"
        },
        "problem": {
          "$ref": "#/$defs/ModelIssue"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "scope",
        "conversation_revision",
        "analysis_config_version",
        "status",
        "result",
        "problem"
      ],
      "title": "Failed",
      "type": "object"
    },
    "Insufficient": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "conversation_revision": {
          "minimum": 0,
          "title": "Conversation Revision",
          "type": "integer"
        },
        "analysis_config_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Analysis Config Version",
          "type": "string"
        },
        "status": {
          "const": "insufficient_evidence",
          "title": "Status",
          "type": "string"
        },
        "result": {
          "title": "Result",
          "type": "null"
        },
        "problem": {
          "$ref": "#/$defs/DataIssue"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "scope",
        "conversation_revision",
        "analysis_config_version",
        "status",
        "result",
        "problem"
      ],
      "title": "Insufficient",
      "type": "object"
    },
    "ModelIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "AI_TIMEOUT",
