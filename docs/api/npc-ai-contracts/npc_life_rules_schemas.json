{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NPC 생활·관계 규칙 스키마 (제안)",
  "description": "$defs의 WorldRules(공통 규칙), NpcLife(NPC별 생활 파일), BehaviorLibrary(행동 조각 모음), PersonaIngredients(인격 카드 생성 재료)를 명시적으로 선택해 검증한다. Unity·AI 워커·백엔드가 같이 읽는 규칙 데이터이며, 설계는 docs/npc-life-design.md. 숫자는 시뮬레이션으로 맞출 초기값이다.",
  "$defs": {
    "RequestLibrary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requests"],
      "properties": {
        "schemaVersion": { "const": "2.0" },
        "requests": { "type": "array", "items": { "$ref": "#/$defs/RequestTemplate" }, "minItems": 1 }
      },
      "description": "대화 중 돌발 부탁·사건의 계기 틀(docs/npc-life-design.md 7절). 계기(욕구가 기준 아래, 또는 장소·시각)와 해결 방식(그 대화 안 / 다른 가게 심부름)만 적고, 심부름 해결처는 공통 규칙의 장소 제공 목록(places.<CODE>.offers)과 조합해 고른다. 부탁하는 쪽은 NPC id가 아니라 역할·장소로 적어 자동 생성 NPC에도 쓴다."
    },
    "RequestTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "roles", "activities", "solve", "reason", "ko", "reward"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
        "trigger": {
          "oneOf": [{ "$ref": "#/$defs/NeedTrigger" }, { "$ref": "#/$defs/SituationTrigger" }],
          "description": "욕구 계기(need·below) 또는 상황 계기(places·windows)."
        },
        "roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/Role" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "부탁하는 NPC의 역할."
        },
        "activities": {
          "type": "array",
          "items": { "type": "string", "enum": ["WORK", "BREAK", "FREE"] },
          "minItems": 1,
          "uniqueItems": true,
          "description": "이 활동 중일 때만 부탁한다."
        },
        "solve": {
          "type": "string",
          "enum": ["TALK", "ERRAND"],
          "description": "TALK: 그 대화 안에서 goal을 이루면 끝. ERRAND: 해결처 직원에게 사거나 부탁한 뒤 돌아와 건넨다."
        },
        "goal": { "$ref": "#/$defs/RequestGoal", "description": "TALK일 때 이 대화에서 판정할 목표." },
        "titleKo": { "type": "string", "minLength": 1, "maxLength": 30, "pattern": "\\S", "description": "TALK일 때 부탁 카드 제목의 할 일. 심부름은 고른 제공의 taskKo를 쓴다." },
        "offer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["place", "key"],
          "properties": { "place": { "$ref": "#/$defs/Code" }, "key": { "$ref": "#/$defs/OfferKey" } },
          "description": "상황 계기의 심부름 해결처. 욕구 계기의 심부름은 비우고, 그 욕구를 채우는 제공 가운데 자기 근무지가 아닌 것을 고른다."
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S", "description": "NPC가 부탁을 꺼내는 이유(영어). 백엔드가 대답 지시문에 담아 LLM이 자연스럽게 꺼내게 한다." },
        "ko": { "type": "string", "minLength": 1, "maxLength": 150, "pattern": "\\S" },
        "reward": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coins", "impression"],
          "properties": {
            "coins": { "type": "integer", "minimum": 0, "maximum": 50, "description": "완료하면 받는 코인." },
            "impression": { "type": "integer", "minimum": 0, "maximum": 100, "description": "완료하면 부탁한 NPC가 갖는 인상. 호감은 relationship.affinityFollowRate만큼 오른다." },
            "fills": { "$ref": "#/$defs/Fills", "description": "완료하면 부탁한 NPC의 욕구가 채워지는 양. 욕구 심부름은 비우고 고른 제공의 fills를 쓴다." }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "solve": { "const": "TALK" } } }, "then": { "required": ["goal", "titleKo"], "not": { "required": ["offer"] } } },
        { "if": { "properties": { "solve": { "const": "ERRAND" } } }, "then": { "not": { "required": ["goal"] } } }
      ]
    },
    "NeedTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["need", "below"],
      "properties": {
        "need": { "$ref": "#/$defs/NeedId", "description": "이 욕구가 below 아래로 떨어지면 부탁한다." },
        "below": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "SituationTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows"],
      "properties": {
        "places": {
          "type": "array",
          "items": { "$ref": "#/$defs/Code" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "이 장소에서 일하는 NPC만. 없으면 어느 근무지든."
        },
        "windows": {
          "type": "array",
          "items": { "$ref": "#/$defs/TimeRange" },
          "minItems": 1,
          "description": "게임 시각이 이 안일 때만."
        },
        "firstTalkOfDay": { "type": "boolean", "description": "그 게임 날 그 학습자와의 첫 대화일 때만." }
      }
    },
    "RequestGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "desc", "languageFocus"],
      "properties": {
        "intent": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64, "description": "의도 판정(/v1/judge)에 넘기는 의도 id." },
        "desc": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S", "description": "판정 모델에 주는 의도 설명(영어)." },
        "languageFocus": { "$ref": "#/$defs/LanguageFocus" }
      }
    },
    "LanguageFocus": {
      "type": "array",
      "items": { "type": "string", "enum": ["ordering", "polite_request", "giving_directions", "recommending", "describing", "thanking", "small_talk"] },
      "minItems": 1,
      "uniqueItems": true,
      "description": "연습하는 말하기 기능."
    },
    "OfferKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 32 },
    "Offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "en", "ko", "taskKo", "stepKo", "price", "languageFocus"],
      "properties": {
        "key": { "$ref": "#/$defs/OfferKey" },
        "en": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S", "description": "지시문·판정 설명에 넣는 영어 이름(관사 포함)." },
        "ko": { "type": "string", "minLength": 1, "maxLength": 30, "pattern": "\\S", "description": "부탁 카드에 쓰는 이름." },
        "taskKo": { "type": "string", "minLength": 1, "maxLength": 30, "pattern": "\\S", "description": "부탁 카드 제목의 할 일. 예: 크루아상 사다 주기" },
        "stepKo": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S", "description": "해결처 단계 문구. 장소 이름 뒤에 붙인다. 예: 크루아상 포장 주문하기" },
        "fills": { "$ref": "#/$defs/Fills", "description": "부탁한 NPC에게 건네면 채워지는 욕구. 없으면 상황 계기가 찾는 서비스." },
        "price": { "type": "integer", "minimum": 0, "maximum": 100, "description": "가게 값(코인). 부탁한 NPC가 먼저 건넨다는 설정이라 학습자 코인은 들지 않고 지시문에만 쓴다." },
        "languageFocus": { "$ref": "#/$defs/LanguageFocus" }
      }
    },
    "BehaviorLibrary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "behaviors"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "behaviors": { "type": "array", "items": { "$ref": "#/$defs/Behavior" }, "minItems": 1 }
      },
      "description": "성격 축 쪽이 표시된 행동 조각. 생성기가 NPC 성격에 맞는 조각을 뽑아 인격의 habits·behaviorRules·speechStyle에 글로 넣는다. MBTI 유형별 목록이 아니라 축 표시라서 MBTI·성격 수치·랜덤 어느 입력에서도 같은 모음을 쓴다."
    },
    "Behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "ko", "category", "leans"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
        "text": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S", "description": "인격 글에 들어갈 영어 문장." },
        "ko": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S", "description": "작성자가 읽는 한국어 뜻." },
        "category": { "type": "string", "enum": ["habit", "social", "speech", "inner", "work"] },
        "leans": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/Axis" },
          "additionalProperties": { "type": "string", "enum": ["high", "low"] },
          "minProperties": 1,
          "description": "이 행동이 어느 성격 축의 어느 쪽에 가까운지 (MBTI: E·N·F·J·-T가 각 축의 high)."
        },
        "affects": { "$ref": "#/$defs/BehaviorAffects" },
        "conflictsWith": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "함께 뽑지 않는 조각 id."
        }
      }
    },
    "PersonaIngredients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "names", "ageRanges", "occupations", "traits", "values", "motivations", "interests", "socialBehavior", "speechStyle"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "names": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][a-z]+$", "maxLength": 40 }, "minItems": 1, "uniqueItems": true, "description": "이름 후보. 이미 쓰는 NPC 이름은 생성기가 고르지 않는다." },
        "ageRanges": { "type": "array", "items": { "$ref": "#/$defs/AgeRange" }, "minItems": 1, "uniqueItems": true },
        "occupations": { "type": "array", "items": { "$ref": "#/$defs/Occupation" }, "minItems": 1 },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/TraitIngredient" }, "minItems": 1, "description": "성격 특징. 성격 축마다 NPC가 기운 쪽에서 하나씩 골라 personality.traits에 넣는다." },
        "values": { "type": "array", "items": { "$ref": "#/$defs/TextIngredient" }, "minItems": 1 },
        "motivations": { "type": "array", "items": { "$ref": "#/$defs/TextIngredient" }, "minItems": 1 },
        "interests": { "type": "array", "items": { "$ref": "#/$defs/TextIngredient" }, "minItems": 1, "description": "취미·관심사. background.interests에 넣는다." },
        "socialBehavior": {
          "type": "object",
          "additionalProperties": false,
          "required": ["firstMeeting", "familiarityExpression", "conflictResponse", "boundaries"],
          "properties": {
            "firstMeeting": { "$ref": "#/$defs/SideRule" },
            "familiarityExpression": { "$ref": "#/$defs/SideRule" },
            "conflictResponse": { "$ref": "#/$defs/SideRule" },
            "boundaries": {
              "type": "object",
              "additionalProperties": false,
              "required": ["STAFF", "PASSERBY"],
              "properties": {
                "STAFF": { "type": "array", "items": { "$ref": "#/$defs/IngredientText" }, "maxItems": 8 },
                "PASSERBY": { "type": "array", "items": { "$ref": "#/$defs/IngredientText" }, "maxItems": 8 }
              }
            }
          },
          "description": "인격 카드 socialBehavior 칸. 각 칸은 정한 성격 축의 쪽(high·middle·low)으로 문장을 고르고, 선(boundaries)은 역할로 고른다."
        },
        "speechStyle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tone", "verbosity", "directness", "formality"],
          "properties": {
            "tone": { "type": "array", "items": { "$ref": "#/$defs/SideRule" }, "minItems": 1, "maxItems": 3, "description": "축마다 고른 말을 'and'로 잇는다 (예: lively and warm)." },
            "verbosity": { "$ref": "#/$defs/SideRule" },
            "directness": { "$ref": "#/$defs/SideRule" },
            "formality": {
              "type": "object",
              "additionalProperties": false,
              "required": ["STAFF", "PASSERBY"],
              "properties": {
                "STAFF": { "type": "string", "enum": ["casual", "neutral", "formal"] },
                "PASSERBY": { "type": "string", "enum": ["casual", "neutral", "formal"] }
              }
            }
          },
          "description": "인격 카드 speechStyle 칸. 값은 인격 스키마의 허용 값이어야 하며, 생성 결과를 인격 스키마로 다시 검사한다."
        }
      },
      "description": "인격 카드(NpcProfile) 생성 재료. 생성기(ai/tools/npc_generate.py)가 입력(npcId·MBTI·역할·장소)과 npcId 씨앗으로 골라 뼈대를 만든다. 성격 쪽이 표시된 재료는 그 쪽 NPC만 고른다."
    },
    "AgeRange": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "\\S" },
    "IngredientText": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S" },
    "AxisLean": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/Axis" },
      "additionalProperties": { "type": "string", "enum": ["high", "low"] },
      "minProperties": 1
    },
    "Occupation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "ko", "role"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S", "description": "인격 카드 occupation에 그대로 들어가는 영어." },
        "ko": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
        "role": { "$ref": "#/$defs/Role" },
        "place": { "$ref": "#/$defs/Code", "description": "일하는 장소. 직원(STAFF)이면 필수." },
        "ages": { "type": "array", "items": { "$ref": "#/$defs/AgeRange" }, "minItems": 1, "uniqueItems": true, "description": "이 직업에 맞는 나이대. 없으면 모든 나이대." }
      },
      "if": { "properties": { "role": { "const": "STAFF" } } },
      "then": { "required": ["place"] }
    },
    "TraitIngredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "ko", "leans"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "\\S" },
        "description": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S", "description": "그 특징이 어떻게 드러나는지 행동으로." },
        "ko": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
        "leans": { "allOf": [{ "$ref": "#/$defs/AxisLean" }], "maxProperties": 1 }
      }
    },
    "TextIngredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "ko"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
        "ko": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S" },
        "leans": { "$ref": "#/$defs/AxisLean", "description": "이 성격 쪽 NPC만 고른다. 없으면 누구나." },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/Role" }, "minItems": 1, "uniqueItems": true, "description": "이 역할 NPC만 고른다. 없으면 누구나." }
      }
    },
    "SideRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "high", "middle", "low"],
      "properties": {
        "axis": { "$ref": "#/$defs/Axis" },
        "high": { "$ref": "#/$defs/IngredientText" },
        "middle": { "$ref": "#/$defs/IngredientText", "description": "축 값이 정확히 0.5일 때 (예: -T·-A가 없는 MBTI의 신경성)." },
        "low": { "$ref": "#/$defs/IngredientText" }
      },
      "description": "성격 축 값이 0.5보다 크면 high, 작으면 low, 같으면 middle 문장을 쓴다."
    },
    "Axis": {
      "type": "string",
      "enum": ["openness", "conscientiousness", "extraversion", "agreeableness", "neuroticism"],
      "description": "인격 스키마 personality.dimensions(Big Five 0~1)와 같은 이름."
    },
    "BehaviorAffects": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "needRates": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/NeedId" },
          "additionalProperties": { "$ref": "#/$defs/Scale" },
          "description": "욕구 감소 속도에 곱한다."
        },
        "recognitionRate": { "$ref": "#/$defs/Scale", "description": "손님 얼굴을 외우는 속도에 곱한다." },
        "initiateTalkRate": { "$ref": "#/$defs/Scale", "description": "먼저 말을 거는 빈도에 곱한다." },
        "personalTalkScale": { "$ref": "#/$defs/Scale", "description": "사적인 이야기를 하는 관계 기준에 곱한다." },
        "eventScale": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/EventId" },
          "additionalProperties": { "$ref": "#/$defs/Scale" },
          "description": "그 대화 사건의 기분·인상 변화에 곱한다."
        },
        "salienceBonus": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/EventId" },
          "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 2 },
          "description": "그 대화 사건을 기억할 때 인상 세기에 더한다 (최대 3)."
        },
        "memoryStabilityScale": {
          "type": "object",
          "propertyNames": { "type": "string", "enum": ["1", "2", "3"] },
          "additionalProperties": { "$ref": "#/$defs/Scale" },
          "description": "인상 세기별 기억 유지 기간에 곱한다."
        }
      }
    },
    "Scale": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
    "Role": { "type": "string", "enum": ["STAFF", "PASSERBY"], "description": "NPC 역할. 백엔드 시드의 NPC 유형(npc_type)과 같다." },
    "ActivityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canFill"],
      "properties": {
        "canFill": { "type": "array", "items": { "$ref": "#/$defs/NeedId" }, "minItems": 1, "uniqueItems": true }
      }
    },
    "RoleRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onShift"],
      "properties": {
        "onShift": {
          "type": "string",
          "enum": ["WORK", "FREE"],
          "description": "맡은 교대 동안의 활동. 교대 밖은 퇴근(OFF)이다. 하루 시뮬레이션은 OFF를 세지 않고 다음 일과를 욕구 시작값에서 시작하며, Unity는 NPC를 자기 장소에 두고 자유 시간처럼 쉬게 한다."
        },
        "break": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minutes", "whenShiftOverHours"],
          "properties": {
            "minutes": { "type": "integer", "minimum": 1, "maximum": 120 },
            "whenShiftOverHours": { "type": "number", "minimum": 0, "maximum": 24, "description": "교대가 이 시간보다 길면 쉰다." }
          },
          "description": "교대 가운데에 한 번 쉬는 시간(BREAK). 교대 가운데 시각에서 가장 가까운 30분 단위 시각(딱 중간이면 이른 쪽)에 시작한다. 없으면 쉬지 않는다."
        }
      },
      "description": "맡은 교대를 하루 일과로 바꾸는 역할 규칙. 일과는 게임 시각 기준으로 하루 24시간을 겹치지 않고 빈틈없이 채운다(검사 도구가 확인). 장소는 NPC의 기본 장소."
    },
    "TimeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/Clock" },
        "to": { "$ref": "#/$defs/Clock", "description": "from보다 이르면 자정을 넘긴다. 같으면 하루 전체." }
      }
    },
    "Shift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "$ref": "#/$defs/Clock" },
        "to": { "$ref": "#/$defs/Clock", "description": "from보다 이르면 자정을 넘긴다. 같으면 하루 전체." },
        "breakAt": { "$ref": "#/$defs/Clock", "description": "휴식 시작 시각. 교대 안에 있어야 하며 없으면 가운데에 쉰다. 다음 직원과 겹치는 시간으로 지정해 응대 공백을 막는다." }
      }
    },
    "Place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shifts"],
      "properties": {
        "name": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "ko"],
          "properties": {
            "en": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "\\S" },
            "ko": { "type": "string", "minLength": 1, "maxLength": 30, "pattern": "\\S" }
          },
          "description": "지시문(영어)과 부탁 카드(한국어)에 쓰는 장소 이름. 제공 목록이 있는 장소는 둔다(검사 도구가 확인)."
        },
        "offers": {
          "type": "array",
          "items": { "$ref": "#/$defs/Offer" },
          "minItems": 1,
          "description": "학습자가 이 장소에서 남을 대신해 사거나 부탁할 수 있는 것. 돌발 부탁의 심부름 해결처가 된다(docs/npc-life-design.md 7.3)."
        },
        "hours": {
          "$ref": "#/$defs/TimeRange",
          "description": "영업시간. 없으면 24시간 연다. 있으면 문을 연 동안은 교대가 하나 이상 맡고, 영업시간 밖에 걸친 교대가 없어야 한다(검사 도구가 확인)."
        },
        "shifts": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/Code" },
          "additionalProperties": { "$ref": "#/$defs/Shift" },
          "minProperties": 1,
          "description": "교대 이름 → 시간. NPC 생활 파일의 shift가 이 가운데 하나를 맡는다. 행인이 지내는 마을(TOWN)에서는 마을에 나와 있는 시간대다."
        }
      }
    },
    "ConnectionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "axis", "at0", "at1"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^(needRates\\.(HUNGER|ENERGY|SOCIAL|FUN|WORK)|recognitionRate|initiateTalkRate|personalTalkScale|eventScale\\.(GREETING|SMALL_TALK|PERSONAL_QUESTION|RUDE|APOLOGY|COMPLIMENT|HELP|TASK_DONE|LEAVE))$",
          "description": "계산할 생활 값 배수. 이름은 행동 조각 affects와 같다."
        },
        "axis": { "$ref": "#/$defs/Axis" },
        "at0": { "$ref": "#/$defs/Scale", "description": "축이 0일 때 배수." },
        "at1": { "$ref": "#/$defs/Scale", "description": "축이 1일 때 배수. 그 사이는 직선." }
      }
    },
    "NpcLife": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "npcId", "mbti", "role", "workplace", "shift"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "npcId": { "$ref": "#/$defs/Code", "description": "인격 파일(ai/npcs/<npcId>.json)·백엔드 시드와 같은 NPC 코드. 행동 조각 뽑기의 씨앗." },
        "mbti": {
          "type": "string",
          "pattern": "^[EI][NS][FT][JP](-[AT])?$",
          "description": "성격 입력 노드. 계산할 때 Big Five 5축으로 바꾼다(ai/tools/npc_derive.py). -T/-A는 신경성."
        },
        "role": { "$ref": "#/$defs/Role", "description": "역할 입력 노드. 맡은 교대를 하루 일과로 바꾸는 공통 규칙의 역할 규칙을 고른다." },
        "workplace": { "$ref": "#/$defs/Code", "description": "일하거나 지내는 곳. 공통 규칙 places의 장소 코드(검사 도구가 확인). 기본 장소(인격 파일의 defaultLocationId)와 다를 수 있다(거리 매장 직원은 마을)." },
        "shift": { "$ref": "#/$defs/Code", "description": "맡은 교대. workplace 장소의 shifts 이름 가운데 하나(검사 도구가 확인)." },
        "resident": { "type": "boolean", "default": false, "description": "24시간 상주 여부. true이면 교대·휴식·퇴근 없이 근무지에 남는다. Mia·Jake·Alex만 사용한다." },
        "tutorialGuide": {
          "type": "boolean",
          "description": "튜토리얼 안내 NPC(하나뿐). 학습자가 튜토리얼을 마치기 전까지는 튜토리얼 모드로 정해진 흐름(Unity 대본)만 따르고, 생활 시뮬레이션·부탁·AI 자유 대화를 하지 않는다."
        }
      },
      "description": "NPC마다 정하는 입력 노드만 둔다. 생활 값 배수·행동·일과는 손으로 적지 않고 공통 규칙으로 계산한다(일과는 맡은 교대와 역할 규칙으로)."
    },
    "Clock": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "게임 시각 HH:MM"
    },
    "NeedId": {
      "type": "string",
      "enum": ["HUNGER", "ENERGY", "SOCIAL", "FUN", "WORK"],
      "description": "욕구. 모두 높을수록 채워진 상태이고 시간이 지나면 줄어든다 (WORK는 할 일을 처리한 정도)."
    },
    "EventId": {
      "type": "string",
      "enum": ["GREETING", "SMALL_TALK", "PERSONAL_QUESTION", "RUDE", "APOLOGY", "COMPLIMENT", "HELP", "TASK_DONE", "LEAVE"],
      "description": "대화 사건. AI 워커가 대사를 만드는 같은 호출에서 판정한다."
    },
    "Emotion": {
      "type": "string",
      "enum": ["PLEASED", "ANNOYED", "HURT", "TIRED", "BORED"]
    },
    "Code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 64,
      "description": "장소 코드·NPC 코드·행동 이름. 백엔드 시드와 Unity가 쓰는 대문자 코드."
    },
    "Fills": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/NeedId" },
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 100 },
      "minProperties": 1,
      "description": "행동을 마치면 욕구가 채워지는 양."
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectKey", "scene", "action", "fills", "minutes"],
      "properties": {
        "objectKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64,
          "description": "사물 단어 키(backend/src/main/resources/content/object-words.json). NPC가 쓰는 사물이 학습 어휘와 이어진다."
        },
        "scene": { "$ref": "#/$defs/Code" },
        "action": { "$ref": "#/$defs/Code" },
        "fills": { "$ref": "#/$defs/Fills" },
        "minutes": { "type": "integer", "minimum": 1, "maximum": 240, "description": "게임 시각 기준으로 걸리는 시간." },
        "onlyRole": {
          "$ref": "#/$defs/Role",
          "description": "이 행동을 할 수 있는 역할(그 장소의 직원 등). 생략하면 누구나. NPC id로 제한하지 않는다."
        }
      }
    },
    "EventEffect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mood": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/Emotion" },
          "additionalProperties": { "type": "integer", "minimum": -3, "maximum": 3 },
          "description": "이번 대화의 기분 변화. 대화가 이어지는 동안 mood.decayPerTurn씩 가라앉는다."
        },
        "impression": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "이 사건의 인상. 그 말을 한 턴에 호감이 relationship.affinityFollowRate만큼 바로 바뀐다(같은 사건은 한 대화에서 한 번)."
        },
        "memorySalience": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "이 사건을 기억으로 남길 때의 인상 세기. 생략하면 기억으로 남기지 않는다."
        }
      }
    },
    "WorldRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "needs", "actions", "conversationEvents", "mood", "relationship", "memory", "derivation", "roles", "activities", "workMeals", "favors", "places"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "workMeals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spreadMinutes", "times"],
          "properties": {
            "spreadMinutes": { "type": "integer", "minimum": 0, "maximum": 180, "description": "NPC마다 npcId 씨앗으로 ±이만큼 엇갈린다." },
            "times": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["at", "need"],
                "properties": { "at": { "$ref": "#/$defs/Clock" }, "need": { "$ref": "#/$defs/NeedId" } }
              },
              "minItems": 1
            }
          },
          "description": "근무 중 짧은 끼니·커피. 근무 중인 NPC도 이 때 그 욕구를 시작값으로 되돌린다(이미 높으면 그대로). 끼니 사이에는 자리를 비울 수 없어 부탁이 된다(docs/npc-life-design.md 7.5)."
        },
        "favors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkAfterLearnerLines", "learnerGapMinutes", "errandExpiryMinutes", "minShiftLeftMinutes", "dislikedBelow"],
          "properties": {
            "checkAfterLearnerLines": { "type": "integer", "minimum": 1, "maximum": 10, "description": "학습자의 이 번째 정상 발화 뒤에 부탁을 볼지 정한다." },
            "learnerGapMinutes": { "type": "integer", "minimum": 0, "maximum": 1440, "description": "부탁이 끝난 뒤 새 부탁을 꺼내지 않는 게임 분." },
            "errandExpiryMinutes": { "type": "integer", "minimum": 60, "maximum": 2880, "description": "심부름을 수락한 뒤 기한(게임 분)." },
            "minShiftLeftMinutes": { "type": "integer", "minimum": 0, "maximum": 1440, "description": "근무가 이만큼 남은 NPC만 심부름을 부탁한다." },
            "dislikedBelow": { "type": "integer", "minimum": -100, "maximum": 0, "description": "호감이 이보다 낮으면 부탁하지 않는다." }
          },
          "description": "대화 중 돌발 부탁의 빈도·기한 상수(docs/npc-life-design.md 7.6·7.10)."
        },
        "activities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["WORK", "BREAK", "FREE"],
          "properties": {
            "WORK": { "$ref": "#/$defs/ActivityRule" },
            "BREAK": { "$ref": "#/$defs/ActivityRule" },
            "FREE": { "$ref": "#/$defs/ActivityRule" }
          },
          "description": "활동 중에 사물 행동으로 채울 수 있는 욕구. 근무 중에는 일만 해서, 자리를 못 비우는 직원의 다른 욕구는 부탁이 된다."
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["STAFF", "PASSERBY"],
          "properties": {
            "STAFF": { "$ref": "#/$defs/RoleRule" },
            "PASSERBY": { "$ref": "#/$defs/RoleRule" }
          },
          "description": "역할별로 맡은 교대를 하루 일과로 바꾸는 규칙. 역할은 백엔드 시드의 NPC 유형(npc_type)과 같다. NPC 일과는 손으로 적지 않고 생활 파일의 근무지·교대와 이 규칙으로 계산한다."
        },
        "places": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/Code" },
          "additionalProperties": { "$ref": "#/$defs/Place" },
          "minProperties": 1,
          "description": "장소별 영업시간과 교대. 코드는 백엔드 시드의 장소 코드, 거리 매장은 Unity 택시 목적지 코드와 같다. Unity에는 영업시간을 내보낸다(ai/tools/npc_life_export.py)."
        },
        "derivation": {
          "type": "array",
          "items": { "$ref": "#/$defs/ConnectionRule" },
          "minItems": 1,
          "description": "성격 5축 → 생활 값 배수 연결 규칙. NPC마다 값을 손으로 적지 않고 이 규칙으로 계산한다(ai/tools/npc_derive.py)."
        },
        "needs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["HUNGER", "ENERGY", "SOCIAL", "FUN", "WORK"],
          "properties": {
            "HUNGER": { "$ref": "#/$defs/NeedRule" },
            "ENERGY": { "$ref": "#/$defs/NeedRule" },
            "SOCIAL": { "$ref": "#/$defs/NeedRule" },
            "FUN": { "$ref": "#/$defs/NeedRule" },
            "WORK": { "$ref": "#/$defs/NeedRule" }
          }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Action" },
          "minItems": 1
        },
        "conversationEvents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["GREETING", "SMALL_TALK", "PERSONAL_QUESTION", "RUDE", "APOLOGY", "COMPLIMENT", "HELP", "TASK_DONE", "LEAVE"],
          "properties": {
            "GREETING": { "$ref": "#/$defs/EventEffect" },
            "SMALL_TALK": { "$ref": "#/$defs/EventEffect" },
            "PERSONAL_QUESTION": { "$ref": "#/$defs/EventEffect" },
            "RUDE": { "$ref": "#/$defs/EventEffect" },
            "APOLOGY": { "$ref": "#/$defs/EventEffect" },
            "COMPLIMENT": { "$ref": "#/$defs/EventEffect" },
            "HELP": { "$ref": "#/$defs/EventEffect" },
            "TASK_DONE": { "$ref": "#/$defs/EventEffect" },
            "LEAVE": { "$ref": "#/$defs/EventEffect" }
          },
          "description": "모든 NPC 공통 효과. NPC별 생활 파일에서 덮어쓸 수 있다."
        },
        "mood": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decayPerTurn", "showsAt"],
          "properties": {
            "decayPerTurn": { "type": "number", "exclusiveMinimum": 0, "maximum": 3, "description": "학습자가 한 번 말할 때마다 기분 세기가 가라앉는 양." },
            "showsAt": { "type": "number", "exclusiveMinimum": 0, "maximum": 3, "description": "기분 세기(0~3)가 이 값 이상이면 말투에 드러난다." }
          }
        },
        "relationship": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recognitionPerConversation",
            "seenBefore",
            "regular",
            "liked",
            "disliked",
            "personalTalk",
            "graceDays",
            "recognitionDropPerDay",
            "affinityFollowRate",
            "rudeAffinityFallback",
            "goodConversationAffinity",
            "goodConversationMinLearnerLines"
          ],
          "properties": {
            "recognitionPerConversation": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100,
              "description": "정상 종료된 대화마다 알아봄이 오르는 기본값. 실제로는 × (1 − 현재/100) × NPC 배수."
            },
            "seenBefore": { "type": "integer", "minimum": 0, "maximum": 100, "description": "이 알아봄부터 '본 적 있음'." },
            "regular": { "type": "integer", "minimum": 0, "maximum": 100, "description": "이 알아봄부터 '단골'." },
            "liked": { "type": "integer", "minimum": 0, "maximum": 100, "description": "이 호감부터 좋아하는 티가 난다." },
            "disliked": { "type": "integer", "minimum": -100, "maximum": 0, "description": "이 호감 이하면 싫어하는 티가 난다(차갑게 대함)." },
            "personalTalk": {
              "type": "object",
              "additionalProperties": false,
              "required": ["recognition", "affinity"],
              "properties": {
                "recognition": { "type": "integer", "minimum": 0, "maximum": 100 },
                "affinity": { "type": "integer", "minimum": -100, "maximum": 100 }
              },
              "description": "두 값을 모두 넘으면 자기 이야기를 조금 한다."
            },
            "graceDays": { "type": "integer", "minimum": 0, "description": "마지막 대화 뒤 알아봄이 줄지 않는 날 수." },
            "recognitionDropPerDay": { "type": "number", "minimum": 0, "maximum": 100 },
            "affinityFollowRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "사건 인상이 호감으로 옮겨지는 비율. 발화마다 그 몫(사건 인상 × 이 비율 × NPC 반응 크기)을 바로 더하고, 무례도 같은 계산으로 깎는다."
            },
            "rudeAffinityFallback": {
              "type": "integer",
              "minimum": -100,
              "maximum": 0,
              "description": "무례 판정(/v1/guard)이 무례라고 했는데 감점량(affinity_delta)이 비었을 때 백엔드가 쓰는 감점. 성격 배수가 없는 NPC의 감점과 같게 둔다."
            },
            "goodConversationAffinity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "대화가 끝난 뒤 기억 카드를 만드는 모델(/v1/memory)이 이번 대화를 좋았다(good)고 보면 더하는 호감. 무례로 확정된 줄이 있는 대화에는 주지 않는다."
            },
            "goodConversationMinLearnerLines": {
              "type": "integer",
              "minimum": 1,
              "description": "좋은 대화 호감을 주려면 학습자가 이번 대화에서 말한 최소 줄 수. 짧게 끊고 다시 거는 반복으로 호감을 쌓지 못하게 한다."
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stabilityDays", "recallAt", "spacedRepeatFactor", "sameDayFactor"],
          "properties": {
            "stabilityDays": {
              "type": "object",
              "additionalProperties": false,
              "required": ["1", "2", "3"],
              "properties": {
                "1": { "type": "number", "exclusiveMinimum": 0 },
                "2": { "type": "number", "exclusiveMinimum": 0 },
                "3": { "type": "number", "exclusiveMinimum": 0 }
              },
              "description": "인상 세기(1 평범·2 대화 거리·3 강한 감정)별 처음 유지 기간(일)."
            },
            "recallAt": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "description": "exp(−지난 날 수 / 유지 기간)이 이 값 이상인 기억만 떠올린다."
            },
            "spacedRepeatFactor": { "type": "number", "minimum": 1, "description": "날을 두고 같은 일이 다시 일어나면 유지 기간에 곱한다." },
            "sameDayFactor": { "type": "number", "minimum": 1, "description": "같은 날 다시 일어나면 유지 기간에 곱한다." }
          }
        }
      }
    },
    "NeedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dropPerHour", "start"],
      "properties": {
        "start": { "type": "number", "minimum": 0, "maximum": 100, "description": "NPC가 하루를 시작할 때(퇴근 뒤 다시 나타날 때)의 값." },
        "dropPerHour": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "게임 시각 한 시간에 줄어드는 양. NPC별 생활 파일의 배수를 곱한다."
        },
        "conversationFill": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "학습자와 대화를 마치면 채우는 양. 없으면 대화로 채우지 않는다. 채우는 사물이 없는 사교만 둔다."
        }
      }
    }
  }
}
