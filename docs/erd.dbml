Ref: user_vocab.source_turn_id > turns.id [color: #9AA3AE]
Ref: user_word_prefs.user_id > users.id [color: #9AA3AE]
Ref: conversations.user_id > users.id [color: #9AA3AE]
Ref: conversations.npc_id > npcs.id [color: #9AA3AE]
Ref: conversations.review_card_id > review_cards.id [color: #9AA3AE]
Ref: training_recordings.user_id > users.id [color: #9AA3AE]
Ref: training_recordings.conversation_id > conversations.id [color: #9AA3AE]
Ref: conversation_feedback.conversation_id - conversations.id [color: #9AA3AE]
Ref: turn_feedback.turn_id - turns.id [color: #9AA3AE]
Ref: user_npc_relations.user_id > users.id [color: #9AA3AE]
Ref: user_npc_relations.npc_id > npcs.id [color: #9AA3AE]
Ref: user_game_clocks.user_id - users.id [color: #9AA3AE]
Ref: user_daily_activities.user_id > users.id [color: #9AA3AE]
