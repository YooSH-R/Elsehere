Project elsehere {
  database_type: 'PostgreSQL'
  Note: '''
  ELSEHERE ERD v3.7 (MVP 기준) · PostgreSQL 16 + pgvector
  회의 보드 결정 + MVP 와이어프레임 피드백 기준. W3 사건 · 세계 사실 테이블은 제외
  API: docs/api/mvp-api.md
  모든 테이블은 created_at · updated_at을 가진다 (백엔드 BaseEntity가 기록). started_at · saved_at 같은 업무 시각은 별도 컬럼으로 유지

  DBML로 표현하지 못해 DDL에서 직접 만들 것
  - CREATE EXTENSION IF NOT EXISTS vector;
  - 부분 인덱스: npc_memories (인덱스 note 참고)
  '''
}

// ===== 가입 · 초기 설정 =====
Table users [headercolor: #3D4A5C] {
  id bigint [pk, increment]
  provider varchar(20) [not null, note: '로그인 방식 · GOOGLE(소셜 로그인) · GUEST(게스트로 시작하기, API AUTH-07)']
  provider_uid varchar(100) [not null, note: '제공자가 주는 사용자 고유 ID · 게스트는 서버가 만든 임의 값']
  email varchar(255) [note: '제공자가 줄 때만']
  nickname varchar(30) [not null, unique, note: 'NPC가 부르는 이름 · 중복 불가 · 한글 2, 영문·숫자 1로 세어 2자 이상 합계 16 이하 (API AUTH-04)']
  avatar_type varchar(10) [not null, note: 'F / M 캐릭터 기본형']
  onboarding_step varchar(20) [not null, note: 'LANG→LEVEL→TUTORIAL→DONE · 튜토리얼 완료·건너뛰기 시 DONE (튜토리얼 기록은 이 값만 사용)']
  current_language varchar(10) [not null, note: 'en-US']
  ui_theme varchar(20) [not null, default: 'JELLY', note: '화면 테마 · JELLY / STICKER / CLOUD · 집에서 고르며 계정에 저장해 기기와 관계없이 유지 (API USER-01)']
  role varchar(10) [not null, default: 'USER', note: 'USER / ADMIN · ADMIN만 운영자 어드민(/admin) 사용 · 가입은 항상 USER, 관리자는 다른 관리자가 어드민에서 지정·해제 (docs/admin.md)']
  last_scene_id bigint [note: '재접속 위치']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (provider, provider_uid) [unique]
  }

  Note: '사용자'
}

Table user_consents [headercolor: #3D4A5C] {
  id bigint [pk, increment]
  user_id bigint [not null]
  consent_type varchar(20) [not null, note: 'TERMS · PRIVACY · VOICE · AGE14 · TRAINING_TEXT · TRAINING_VOICE(AI 개선 선택 동의, docs/ai-training-data.md)']
  version varchar(20) [not null, note: '약관 버전']
  agreed_at timestamptz [not null]
  withdrawn_at timestamptz [note: '철회 시각 · 철회해도 행을 지우지 않고, 다시 동의하면 새 행']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '약관 동의'
}

Table user_language_profiles [headercolor: #3D4A5C] {
  user_id bigint [not null]
  language_code varchar(10) [not null]
  recommended_level smallint [note: '테스트 추천값']
  selected_level smallint [not null, note: 'MVP는 1 고정']
  last_test_id bigint
  updated_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, language_code) [pk]
  }

  Note: '언어별 학습 설정'
}

Table level_tests [headercolor: #3D4A5C] {
  id bigint [pk, increment]
  user_id bigint [not null]
  language_code varchar(10) [not null]
  status varchar(20) [not null, note: 'IN_PROGRESS · DONE · QUIT · SKIPPED']
  score smallint
  result_level smallint
  started_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '레벨 테스트'
}

Table level_test_answers [headercolor: #3D4A5C] {
  id bigint [pk, increment]
  test_id bigint [not null]
  item_code varchar(50) [not null, note: '문항 ID']
  answer text [not null]
  is_correct boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '테스트 응답'
}

// ===== 월드 마스터 =====
Table scenes [headercolor: #2F4A7A] {
  id bigint [pk, increment]
  code varchar(30) [not null, unique, note: 'HOME · TOWN · CAFE']
  name varchar(50) [not null]
  unity_key varchar(50) [not null, note: 'Unity 씬 이름 (HomeScene · CafeScene)']
  is_open boolean [not null, default: false, note: 'MVP는 집·마을·카페·호텔 모두 true. 이후 준비 중인 장소만 false']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '장면 · 장소'
}

Table npcs [headercolor: #2F4A7A] {
  id bigint [pk, increment]
  scene_id bigint [not null]
  code varchar(30) [not null, unique, note: 'Unity·시드·프롬프트에서 쓰는 고정 키 (예: TOWN_PASSERBY · CAFE_STAFF)']
  name varchar(30) [not null]
  npc_type varchar(20) [not null, note: 'PASSERBY · STAFF']
  role_label varchar(30) [not null, note: '화면에 보여주는 역할 이름 (행인 · 카페 직원). persona는 AI 프롬프트용이라 따로 둔다']
  persona jsonb [not null, note: 'AI 워커 npc 형식 {role, facts, scene} · 시드는 처음 넣을 때만 쓰고 이후에는 운영자 어드민에서 고침 (docs/admin.md)']
  profile jsonb [note: '인격 카드 (AI 공통 스키마 npcProfile, camelCase 그대로) · 워커 요청 npc.profile · 시드 로더가 content/npc-configurations.json으로 카드가 없을 때만 넣음 · 없으면 persona.role 한 줄로 대답']
  voice_id varchar(30) [not null, note: 'TTS 보이스']
  can_initiate boolean [not null, default: false, note: 'NPC가 먼저 말을 거는지 (사용자→NPC 대화와 무관)']
  approach_line text [note: '먼저 말을 걸 때의 첫 말 (can_initiate NPC)']
  approach_audio_key varchar(100) [note: '첫 말 음성 파일 키 (미리 생성)']
  farewell_line text [note: '대화 중 AI 사용량이 떨어졌을 때의 작별 대사']
  farewell_audio_key varchar(100) [note: '작별 대사 음성 파일 키 (미리 생성)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'NPC'
}

Table scene_words [headercolor: #2F4A7A] {
  id bigint [pk, increment]
  scene_id bigint [not null]
  vocab_id bigint [not null, note: '장소의 사물에 붙은 공용 단어']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (scene_id, vocab_id) [unique]
  }

  Note: '장소별 사물 단어 (v3.4). Unity가 내보낸 object-word-bindings.json의 장소별 단어 키로 시드. 여러 사물이 같은 단어를 쓰면 한 행'
}

// ===== 어휘 · 단어장 =====
Table vocabularies [headercolor: #227C88] {
  id bigint [pk, increment]
  language_code varchar(10) [not null]
  type varchar(10) [not null, note: 'WORD · IDIOM · SENTENCE']
  text text [not null]
  meaning_ko text [not null]
  example text [note: '예문 · 사물 카드에 표시하는 시점(저장 전/후) [미정]']
  example_ko text [note: '예문 뜻']
  pronunciation_audio_key varchar(100) [note: '미리 TTS로 만든 발음 파일 이름 ({wordKey}.wav). Unity 에셋 값이 없으면 시드가 content/pronunciation의 파일로 채운다']
  word_key varchar(50) [unique, note: 'Unity 공용 단어 키 (air_conditioner · sofa ...). 사물 단어만 값이 있다 (v3.4)']
  source varchar(20) [not null, note: 'MASTER · NPC · FEEDBACK']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (language_code, text) [unique]
  }

  Note: '어휘 · 표현'
}

Table user_vocab [headercolor: #227C88] {
  id bigint [pk, increment]
  user_id bigint [not null]
  vocab_id bigint [not null]
  source_type varchar(20) [not null, note: 'OBJECT · NPC_LINE · FEEDBACK']
  source_turn_id bigint [note: '저장한 대화 턴']
  source_conversation_id bigint [note: '저장한 대화 (NPC_LINE · FEEDBACK). 턴 없이 대화 단위로 저장하는 짧은 피드백 때문에 따로 둔다. OBJECT는 NULL']
  context_text text [note: '단어를 저장한 문장 (NPC 대사 · 피드백 예문 · 사물 예문)']
  context_meaning_ko text [note: '그 문장의 뜻']
  memo text [note: '사용자 메모']
  memorized_at timestamptz [note: '외웠어요 → 목록에서 정리']
  saved_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, vocab_id) [unique]
    (user_id, `saved_at DESC`) [note: '단어장 목록(최근 저장순)']
  }

  Note: '단어장'
}

Table user_word_prefs [headercolor: #227C88] {
  user_id bigint [not null]
  vocab_id bigint [not null]
  hover_hidden boolean [not null, default: false, note: '알아요 · 다음에 안 띄우기. 같은 단어가 붙은 모든 사물에 적용']
  updated_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, vocab_id) [pk]
  }

  Note: '사물 카드 호버 숨김 (v3.4: 사물 기준 user_object_prefs에서 단어 기준으로 변경)'
}

// ===== 대화 · 피드백 =====
Table conversations [headercolor: #2E6B4F] {
  id bigint [pk, increment]
  user_id bigint [not null]
  npc_id bigint [not null]
  initiated_by varchar(10) [not null, note: 'USER · NPC']
  level_applied smallint [not null, note: '적용 난이도']
  status varchar(20) [not null, note: 'ACTIVE · ENDED_BY_USER · ENDED_BY_NPC · EXPIRED(이탈·시간 초과)']
  end_reason varchar(20) [note: 'USER_ENDED · NPC_ENDED · QUOTA_EXHAUSTED · RUDE(무례 누적으로 NPC가 끝냄) · EXPIRED']
  rude_count smallint [not null, default: 0, note: '이 대화에서 무례로 센 턴 수 · 한도(서버 설정값, 3)에 닿으면 NPC가 대화를 끝냄']
  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  first_day_stage int [note: '대화 시작 시 첫날 연계 미션 단계 0~6. 피드백 상황 복원용이며 자유 대화는 NULL']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, npc_id, `started_at DESC`)
  }

  Note: 'NPC 자유 대화 세션 (튜토리얼 대본 대화는 기록하지 않음)'
}

Table turns [headercolor: #2E6B4F] {
  id bigint [pk, increment]
  conversation_id bigint [not null]
  seq int [not null, note: '대화 안에서 몇 번째 말인지']
  request_id uuid [unique, note: '사용자 턴 전송 ID · 재전송 시 중복 저장 방지 (NPC 턴은 NULL)']
  speaker varchar(10) [not null, note: 'USER · NPC']
  input_type varchar(10) [note: 'VOICE · TEXT']
  stt_raw_text text [note: 'STT 원본']
  text text [not null, note: '보낸 문장 / NPC 대사']
  translation_en text [note: '학습자 말의 영어 번역 · 번역 카드·다음 요청의 history·피드백에 씀 (사용자 턴만)']
  guard_abusive boolean [note: '무례 판정 · true 무례, false 아님, null 판정 실패(무례로 세지 않음) · 사용자 턴만']
  guard_error_code varchar(30) [note: '판정 실패 이유 · empty · unparsed · timeout · provider_unavailable · provider_limit · worker_unavailable(Spring이 워커에 닿지 못함)']
  events jsonb [note: '의도 판정(/v1/judge)이 고른 대화 사건 문자열 배열 (GREETING · APOLOGY 등) · 다음 요청의 history[].events · 사용자 턴만, 워커가 보내지 않으면 null']
  meaning_ko text [note: '뜻 보기']
  glossary jsonb [note: '단어 호버 뜻']
  suggest_words jsonb [note: '추천 단어 3개']
  hint_text text [note: '힌트 추천 문장']
  hint_opened_at timestamptz [note: '힌트 사용 기록']
  audio_path varchar(255) [note: '쓰지 않음 · 학습 활용에 동의한 녹음은 training_recordings에 저장']
  npc_audio_key varchar(100) [note: 'NPC 턴 TTS 음성 파일 키 · 다시 듣기용 · 턴 생성 후 최대 30일, 환경 전체 5GB(docs/npc-audio-storage.md)']
  npc_audio_deleted_at timestamptz [note: '보관 정책(기간 만료·용량 정리·복원 뒤 파일 없음)으로 음성을 지운 시각 · 처음 합성에 실패한 턴(NULL)과 구분해 다시 만들지 않음']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, seq) [unique]
  }

  Note: '발화 턴'
}

Table training_recordings [headercolor: #2E6B4F] {
  id bigint [pk, increment]
  user_id bigint [not null]
  request_id uuid [not null, note: '음성 인식(CONV-02) 요청 ID']
  purpose varchar(20) [not null, note: 'TURN · TUTORIAL']
  conversation_id bigint [note: 'TURN일 때 대화 · TUTORIAL이면 NULL']
  audio_key varchar(100) [not null, note: '녹음 파일 이름 · 학습용 녹음 폴더(TRAINING_RECORDING_DIR)']
  content_type varchar(100) [not null, note: '받은 녹음 형식(audio/wav 등)']
  stt_text text [not null, note: '음성 인식 결과']
  duration_ms int [note: '음성 길이']
  recorded_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id [name: 'idx_training_recordings_user']
  }

  Note: '학습용 녹음 · 녹음 음성 활용(TRAINING_VOICE)에 동의한 사용자만 저장 · 철회하면 지움 · 프로젝트 종료 후 파기(docs/ai-training-data.md)'
}

Table conversation_feedback [headercolor: #2E6B4F] {
  conversation_id bigint [pk]
  status varchar(20) [not null, note: 'DONE · FAILED · SKIPPED']
  summary text [note: '대화 요약']
  reviews jsonb [note: '{ good: [잘했어요], improve: [아쉬워요], suggestion: { userText, betterText } }']
  model varchar(50)
  error_code varchar(40) [note: 'FAILED·SKIPPED 이유 · 워커 problem 코드(AI_TIMEOUT, NO_USABLE_USER_TURNS 등) 또는 API 오류 코드 · 사용자가 건너뛰면 NULL']
  result jsonb [note: '워커가 돌려준 검증된 피드백 결과 원본 · 평가 근거 보관']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '짧은 피드백 · 대화 종료(CONV-08) 때 상세 평가(turn_feedback)와 함께 만든다'
}

Table turn_feedback [headercolor: #2E6B4F] {
  id bigint [pk, increment]
  turn_id bigint [not null, unique, note: 'USER 턴 1:1']
  better_text text [note: '더 자연스러운 표현 · 고칠 것이 없는 적절한 발화는 NULL']
  reason text [not null, note: '이유 (한국어)']
  idiom text [note: '숙어 추천']
  idiom_meaning_ko text [note: '숙어 뜻']
  model_audio_key varchar(100) [note: '모범 TTS 캐시']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '상세 피드백'
}

// ===== 관계 · 기억 =====
Table user_npc_relations [headercolor: #C8642A] {
  user_id bigint [not null]
  npc_id bigint [not null]
  affinity smallint [not null, default: 0, note: '호감도 -100~100 · 무례로 센 말마다 /v1/guard의 affinity_delta만큼 깎음 (비어 있으면 기본 -4, docs/api/rudeness-handling.md 3절) · 대화가 끝나면 /v1/npc/relationship의 affinity_delta를 더함']
  recognition smallint [not null, default: 0, note: '알아봄 0~100 · 대화가 끝나면 /v1/npc/relationship의 recognition_delta를 더함 · NPC 대답 요청의 relationship']
  talk_count int [not null, default: 0, note: '사용자 발화가 있었던 대화를 끝낸 횟수 · NPC 대답 요청의 memory.visits']
  last_talked_at timestamptz
  memory_card jsonb [note: 'NPC 기억 카드 { name, claims, events, attitude, struggled } · AI 워커 /v1/memory가 만든 카드로 통째로 교체']
  memory_conversation_id bigint [note: '기억에 마지막으로 반영한 대화 · 같은 대화의 종료를 두 번 반영하지 않음']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, npc_id) [pk]
  }

  Note: '호감도 · 알아봄 · 방문 수 · NPC 기억 카드 (docs/api/npc-memory-integration.md)'
}

Table affinity_logs [headercolor: #C8642A] {
  id bigint [pk, increment]
  user_id bigint [not null]
  npc_id bigint [not null]
  delta smallint [not null]
  reason varchar(30) [not null, note: 'MISSION_DONE · FEEDBACK_SKIPPED']
  ref_id bigint [note: '미션 · 대화 ID (reason에 따라 대상이 달라 FK 없음)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '호감도 변경 이력'
}

Table npc_memories [headercolor: #C8642A] {
  id bigint [pk, increment]
  user_id bigint [not null, note: '(user, npc) 사적 기억']
  npc_id bigint [not null]
  conversation_id bigint [not null, note: '어느 대화에서 나온 기억인지']
  fact text [not null, note: '기억할 사실']
  greeting_hook text [note: '다음 방문 인사']
  embedding vector(1536) [note: '기억이 많아지면 관련 있는 것만 골라 찾는 데 사용. 차원은 임베딩 모델을 정한 뒤 확정']
  status varchar(20) [not null, note: 'ACTIVE · REPLACED (취향이 바뀌면 이전 기억을 대체)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, npc_id) [note: '부분 인덱스: WHERE status = \'ACTIVE\'']
  }

  Note: 'NPC 기억(사실별). MVP는 user_npc_relations.memory_card의 카드 방식을 쓰므로 이 테이블은 만들지 않음 · 기억이 많아져 검색이 필요해지면 다시 검토'
}

// ===== 미션 =====
Table missions [headercolor: #5B4B9A] {
  id bigint [pk, increment]
  npc_id bigint [not null, note: '대상 NPC']
  code varchar(50) [not null, unique, note: '시드·Unity에서 미션을 가리키는 고정 키 (예: CAFE_SOY_LATTE)']
  title varchar(100) [not null]
  description text [not null]
  keywords jsonb [not null, note: '완료 판정 키워드']
  intent_rule text [not null, note: 'AI 의도 판정 기준']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '일일 미션 정의 (튜토리얼 미션은 Unity 대본 콘텐츠)'
}

Table user_missions [headercolor: #5B4B9A] {
  id bigint [pk, increment]
  user_id bigint [not null]
  mission_id bigint [not null]
  mission_date date [not null, note: '자정 갱신']
  status varchar(10) [not null, note: 'RUN · DONE']
  completed_at timestamptz
  conversation_id bigint [note: '완료된 대화 (한 대화에서 여러 미션 완료 가능)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, mission_id, mission_date) [unique]
    (user_id, mission_date)
  }

  Note: '미션 진행. 수락 없이 그날 첫 미션 조회 때 RUN으로 자동 생성'
}

Table first_day_missions [headercolor: #5B4B9A] {
  user_id bigint [pk, not null]
  stage int [not null, note: '0~6 현재 단계, 7 전체 완료']
  objectives int [not null, note: '현재 단계에서 확정한 목표 비트 집합']
  balance int [not null, note: '퀘스트 전용 예산. 시작 20, 우산 구매 후 12. 서비스 결제·재화와 별개']
  scene varchar(20) [not null, note: '마지막 보고 장소 HOME/TOWN/CAFE/HOTEL/SHOP']
  version bigint [not null, note: '낙관적 잠금 버전']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: '첫날 연계 미션. 사용자당 하나를 저장하고 자정에 초기화하지 않음. 진행 변경 시 행 잠금'
}

Table ai_candidates [headercolor: #5B4B9A] {
  id bigint [pk, increment]
  turn_id bigint [not null]
  kind varchar(20) [not null, note: 'MISSION_DONE · CONVO_END']
  payload jsonb [not null, note: 'AI 제안']
  decision varchar(10) [not null, note: 'PENDING · APPROVED · REJECTED']
  decided_at timestamptz [note: '서버 확정']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'AI 판정 후보 (AI 제안을 서버가 검증해 확정)'
}

// ===== 운영 =====
Table ai_requests [headercolor: #8A5A44] {
  id bigint [pk, increment]
  request_id uuid [not null, note: '클라이언트 요청 ID · 재전송 시 이전 결과 반환, 한 번만 차감']
  user_id bigint [not null]
  conversation_id bigint
  kind varchar(20) [not null, note: 'AI 워커 기능 단위 · STT · GUARD · JUDGE · NPC · TTS · HINT · MEANING · FEEDBACK · MEMORY (새 호출 종류가 생기면 추가)']
  model varchar(50) [note: '호출한 모델']
  status varchar(20) [not null, note: 'RESERVED · OK · FAILED · BLOCKED']
  input_tokens int [not null, default: 0, note: '공급자가 집계한 입력 토큰']
  output_tokens int [not null, default: 0, note: '공급자가 집계한 출력 토큰']
  audio_ms int [note: 'STT 음성 길이 · 비용 근거. 한도 차감은 초당 토큰 환산(서버 설정값)']
  reserved_tokens int [not null, default: 0, note: '호출 전 예약한 토큰']
  charged_tokens int [not null, default: 0, note: '사용자 한도에서 차감한 토큰. 우리 쪽 실패면 0']
  created_at timestamptz [not null, default: `now()`]
  settled_at timestamptz [note: '정산 시각']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (request_id, kind) [unique]
    (user_id, `created_at DESC`)
  }

  Note: 'AI 호출 기록. 호출 한 번이 한 행 (한 턴의 무례 판정·의도 판정·NPC 대답은 같은 request_id에 kind가 다른 행). input·output_tokens·audio_ms는 비용 근거, charged_tokens는 사용자 한도 차감량. 한도 예약은 턴 단위로 user_ai_usage에 한 번 하고 행별로 정산'
}

Table user_ai_usage [headercolor: #8A5A44] {
  user_id bigint [not null]
  period_start date [not null, note: '한도 갱신 주기의 시작일 (주기 미정)']
  used_tokens int [not null, default: 0, note: '정산이 끝난 차감 토큰 합계']
  reserved_tokens int [not null, default: 0, note: '호출 중인 요청의 예약 토큰 합계']
  updated_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, period_start) [pk]
  }

  Note: '사용자별 토큰 한도 원장. 한도 수치는 서버 설정값. 예약은 used + reserved + 예상량 <= 한도 조건의 UPDATE 한 번으로 원자 처리'
}

// ===== 테이블 그룹 =====
TableGroup signup_onboarding {
  users
  user_consents
  user_language_profiles
  level_tests
  level_test_answers
}

TableGroup world_master {
  scenes
  npcs
  scene_words
}

TableGroup vocabulary {
  vocabularies
  user_vocab
  user_word_prefs
}

TableGroup dialogue {
  conversations
  turns
  conversation_feedback
  turn_feedback
}

TableGroup relation_memory {
  user_npc_relations
  affinity_logs
  npc_memories
}

TableGroup mission {
  missions
  user_missions
  first_day_missions
  ai_candidates
}

TableGroup operation {
  ai_requests
  user_ai_usage
}

// ===== 외래키 =====
Ref: users.last_scene_id > scenes.id
Ref: first_day_missions.user_id > users.id
Ref: user_consents.user_id > users.id
Ref: user_language_profiles.user_id > users.id
Ref: user_language_profiles.last_test_id > level_tests.id
Ref: level_tests.user_id > users.id
Ref: level_test_answers.test_id > level_tests.id
Ref: npcs.scene_id > scenes.id
Ref: scene_words.scene_id > scenes.id
Ref: scene_words.vocab_id > vocabularies.id
Ref: user_vocab.user_id > users.id
Ref: user_vocab.vocab_id > vocabularies.id
Ref: user_vocab.source_turn_id > turns.id
Ref: user_word_prefs.user_id > users.id
Ref: user_word_prefs.vocab_id > vocabularies.id
Ref: conversations.user_id > users.id
Ref: conversations.npc_id > npcs.id
Ref: turns.conversation_id > conversations.id
Ref: training_recordings.user_id > users.id
Ref: training_recordings.conversation_id > conversations.id
Ref: conversation_feedback.conversation_id - conversations.id
Ref: turn_feedback.turn_id - turns.id
Ref: user_npc_relations.user_id > users.id
Ref: user_npc_relations.npc_id > npcs.id
Ref: affinity_logs.user_id > users.id
Ref: affinity_logs.npc_id > npcs.id
Ref: npc_memories.user_id > users.id
Ref: npc_memories.npc_id > npcs.id
Ref: npc_memories.conversation_id > conversations.id
Ref: missions.npc_id > npcs.id
Ref: user_missions.user_id > users.id
Ref: user_missions.mission_id > missions.id
Ref: user_missions.conversation_id > conversations.id
Ref: ai_candidates.turn_id > turns.id
Ref: ai_requests.user_id > users.id
Ref: ai_requests.conversation_id > conversations.id
Ref: user_ai_usage.user_id > users.id
