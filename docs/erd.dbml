Ref: npc_follow_ups.npc_id > npcs.id [color: #9AA3AE]
Ref: npc_follow_ups.conversation_id - conversations.id [color: #9AA3AE]
Ref: user_missions.user_id > users.id [color: #9AA3AE]
Ref: user_missions.conversation_id > conversations.id [color: #9AA3AE]
Ref: ai_requests.user_id > users.id [color: #9AA3AE]
Ref: ai_requests.conversation_id > conversations.id [color: #9AA3AE]
Ref: review_cards.user_id > users.id [color: #9AA3AE]
Ref: review_cards.npc_id > npcs.id [color: #9AA3AE]
Ref: review_cards.source_conversation_id > conversations.id [color: #9AA3AE]

// 설계만 있는 테이블의 관계(회색): 테이블이 DB에 없다
Ref: affinity_logs.user_id > users.id [color: #9AA3AE]
Ref: affinity_logs.npc_id > npcs.id [color: #9AA3AE]
Ref: npc_memories.user_id > users.id [color: #9AA3AE]
