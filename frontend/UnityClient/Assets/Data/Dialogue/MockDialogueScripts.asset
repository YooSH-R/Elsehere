  - npcCode: FIRE_CAPTAIN
    npcName: Ray
    roleLabel: "\uC18C\uBC29\uB300\uC7A5"
    opening:
      english: Morning. I'm Ray, the fire captain.
      korean: "\uC548\uB155\uD558\uC138\uC694. \uC18C\uBC29\uB300\uC7A5 Ray\uC608\uC694."
    guidedTurns: []
