  - npcCode: FIRE_FIGHTER
    npcName: Rachel
    roleLabel: "\uC18C\uBC29\uAD00"
    opening:
      english: Hi, I'm Rachel. I'm a firefighter.
      korean: "\uC548\uB155\uD558\uC138\uC694, \uC800\uB294 \uC18C\uBC29\uAD00 Rachel\uC774\uC5D0\uC694."
    guidedTurns: []
    keywordReplies:
    - keywords:
