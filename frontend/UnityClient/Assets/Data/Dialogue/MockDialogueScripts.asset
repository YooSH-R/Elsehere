    roleLabel: "\uD589\uC778"
    opening:
      english: Oh, good morning! We walk down the main street every morning.
      korean: "\uC5B4\uBA38, \uC88B\uC740 \uC544\uCE68\uC774\uC5D0\uC694! \uC800\uD76C\uB294
