  - npcCode: TOWN_GRANDFATHER
    npcName: Arthur
    roleLabel: "\uD589\uC778"
    opening:
      english: Good morning.
      korean: "\uC88B\uC740 \uC544\uCE68\uC774\uC5D0\uC694."
    guidedTurns: []
    keywordReplies:
    - keywords:
