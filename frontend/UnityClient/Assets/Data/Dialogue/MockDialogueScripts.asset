    - keywords:
      - husband
      reply:
        english: This is my husband, Arthur. He doesn't talk much.
        korean: "\uC81C \uB0A8\uD3B8 Arthur\uC608\uC694. \uB9D0\uC218\uAC00 \uC801\uC5B4\uC694."
