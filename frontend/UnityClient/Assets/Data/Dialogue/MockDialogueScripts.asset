%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c941ad8866de1f94dbe0f36910012d9c, type: 3}
  m_Name: MockDialogueScripts
  m_EditorClassIdentifier: A305.Dialogue::A305.Dialogue.MockDialogueScriptSource
  entries:
  - npcCode: TUTORIAL_PASSERBY
    npcName: Ben
    roleLabel: "\uC774\uC6C3"
    opening:
      english: "Excuse me! Could you tell me how to get to the caf\xE9?"
      korean: "\uC2E4\uB840\uD569\uB2C8\uB2E4! \uCE74\uD398\uC5D0 \uC5B4\uB5BB\uAC8C
        \uAC00\uB294\uC9C0 \uC54C\uB824 \uC8FC\uC2E4 \uC218 \uC788\uB098\uC694?"
      voice: {fileID: 4900000, guid: 5b5b18e11d40c614093ef1b17439f2ef, type: 3}
    guidedTurns:
    - suggestedEnglish: Go straight ahead.
      suggestedKorean: "\uC55E\uC73C\uB85C \uACE7\uC7A5 \uAC00\uC138\uC694."
      reply:
        english: Straight ahead? And then where should I go?
        korean: "\uACE7\uC7A5\uC774\uC694? \uADF8\uB2E4\uC74C\uC5D4 \uC5B4\uB514\uB85C
          \uAC00\uBA74 \uB418\uB098\uC694?"
        voice: {fileID: 4900000, guid: 130a8ebdfea8d3045b9626aa976a7609, type: 3}
      suggestWords:
      - "straight \xB7 \uACE7\uC7A5"
      - "ahead \xB7 \uC55E\uC73C\uB85C"
    - suggestedEnglish: Turn left at the corner.
      suggestedKorean: "\uBAA8\uD241\uC774\uC5D0\uC11C \uC67C\uCABD\uC73C\uB85C \uB3C4\uC138\uC694."
      reply:
        english: Got it. Is it far from here?
        korean: "\uC54C\uACA0\uC5B4\uC694. \uC5EC\uAE30\uC11C \uBA3C\uAC00\uC694?"
        voice: {fileID: 4900000, guid: d87e46ea997622041911f1f694256baf, type: 3}
      suggestWords:
      - "turn left \xB7 \uC67C\uCABD\uC73C\uB85C \uB3CC\uB2E4"
      - "corner \xB7 \uBAA8\uD241\uC774"
    - suggestedEnglish: No, it's just two minutes away.
      suggestedKorean: "\uC544\uB2C8\uC694, 2\uBD84\uC774\uBA74 \uAC00\uC694."
      reply:
        english: Thank you so much. You're a lifesaver!
        korean: "\uC815\uB9D0 \uACE0\uB9C8\uC6CC\uC694. \uB355\uBD84\uC5D0 \uC0B4\uC558\uC5B4\uC694!"
        voice: {fileID: 4900000, guid: 77a922892b0f4a34e8a67a9728c5c371, type: 3}
      suggestWords:
      - "minute \xB7 \uBD84"
      - "away \xB7 \uB5A8\uC5B4\uC838"
    keywordReplies: []
    defaultReply:
      english: I see!
      korean: "\uADF8\uB807\uAD70\uC694!"
      voice: {fileID: 0}
    exampleSentence: 
  - npcCode: CAFE_STAFF
    npcName: Mia
    roleLabel: "\uCE74\uD398 \uC9C1\uC6D0"
    opening:
      english: "Hi there! Welcome to our caf\xE9. What can I get for you?"
      korean: "\uC548\uB155\uD558\uC138\uC694! \uC800\uD76C \uCE74\uD398\uC5D0 \uC624\uC2E0
        \uAC78 \uD658\uC601\uD574\uC694. \uBB34\uC5C7\uC744 \uB4DC\uB9B4\uAE4C\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - soy
      - latte
      reply:
        english: One soy latte, coming right up! Would you like anything else?
        korean: "\uB450\uC720 \uB77C\uD14C \uD55C \uC794 \uBC14\uB85C \uC900\uBE44\uD560\uAC8C\uC694!
          \uB354 \uD544\uC694\uD55C \uAC74 \uC5C6\uC73C\uC138\uC694?"
        voice: {fileID: 0}
    - keywords:
      - latte
      reply:
        english: Sure! Would you like regular milk or soy milk?
        korean: "\uBB3C\uB860\uC774\uC8E0! \uC77C\uBC18 \uC6B0\uC720\uB85C \uB4DC\uB9B4\uAE4C\uC694,
          \uB450\uC720\uB85C \uB4DC\uB9B4\uAE4C\uC694?"
        voice: {fileID: 0}
    - keywords:
      - dessert
      reply:
        english: Yes, we have cheesecake and cookies. The first cookie is on the
          house!
        korean: "\uB124, \uCE58\uC988\uCF00\uC774\uD06C\uC640 \uCFE0\uD0A4\uAC00
          \uC788\uC5B4\uC694. \uCCAB \uBC88\uC9F8 \uCFE0\uD0A4\uB294 \uC11C\uBE44\uC2A4\uC608\uC694!"
        voice: {fileID: 0}
    - keywords:
      - coffee
      reply:
        english: Of course. Hot or iced?
        korean: "\uBB3C\uB860\uC774\uC8E0. \uB530\uB73B\uD55C \uAC78\uB85C \uB4DC\uB9B4\uAE4C\uC694,
          \uC544\uC774\uC2A4\uB85C \uB4DC\uB9B4\uAE4C\uC694?"
        voice: {fileID: 0}
    - keywords:
      - thank
      reply:
        english: You're welcome! Enjoy your day.
        korean: "\uCC9C\uB9CC\uC5D0\uC694! \uC88B\uC740 \uD558\uB8E8 \uBCF4\uB0B4\uC138\uC694."
        voice: {fileID: 0}
    defaultReply:
      english: I see. Is there anything else I can help you with?
      korean: "\uADF8\uB807\uAD70\uC694. \uB354 \uB3C4\uC640\uB4DC\uB9B4 \uC77C\uC774
        \uC788\uC744\uAE4C\uC694?"
      voice: {fileID: 0}
    exampleSentence: Could I have a soy latte, please?
  - npcCode: TOWN_PASSERBY
    npcName: Ben
    roleLabel: "\uD589\uC778"
    opening:
      english: Hey! Nice to see you. How's your day going?
      korean: "\uC548\uB155\uD558\uC138\uC694! \uBC18\uAC00\uC6CC\uC694. \uC624\uB298
        \uD558\uB8E8 \uC5B4\uB54C\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - weather
      reply:
        english: It's a lovely day. Perfect for a walk!
        korean: "\uB0A0\uC528\uAC00 \uC815\uB9D0 \uC88B\uB124\uC694. \uC0B0\uCC45\uD558\uAE30
          \uB531\uC774\uC5D0\uC694!"
        voice: {fileID: 0}
    - keywords:
      - cafe
      reply:
        english: "The corner caf\xE9 has great lattes. You should try one!"
        korean: "\uBAA8\uD241\uC774 \uCE74\uD398 \uB77C\uD14C\uAC00 \uC815\uB9D0
          \uB9DB\uC788\uC5B4\uC694. \uD55C\uBC88 \uB9C8\uC154 \uBD10\uC694!"
        voice: {fileID: 0}
    - keywords:
      - thank
      reply:
        english: Anytime! See you around.
        korean: "\uC5B8\uC81C\uB4E0\uC9C0\uC694! \uB610 \uBD10\uC694."
        voice: {fileID: 0}
    defaultReply:
      english: Oh, really? Tell me more!
      korean: "\uC544, \uC815\uB9D0\uC694? \uB354 \uC598\uAE30\uD574 \uC918\uC694!"
      voice: {fileID: 0}
    exampleSentence: It's a nice day today, isn't it?
  - npcCode: HOTEL_STAFF
    npcName: Jake
    roleLabel: "\uD638\uD154 \uC9C1\uC6D0"
    opening:
      english: Good afternoon! Welcome to Maple House. Are you checking in?
      korean: "\uC548\uB155\uD558\uC138\uC694! \uBA54\uC774\uD50C \uD558\uC6B0\uC2A4\uC5D0
        \uC624\uC2E0 \uAC78 \uD658\uC601\uD574\uC694. \uCCB4\uD06C\uC778\uD558\uC2DC\uB098\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - check
      reply:
        english: Of course. May I have your name, please?
        korean: "\uBB3C\uB860\uC774\uC8E0. \uC131\uD568\uC744 \uC54C\uB824 \uC8FC\uC2DC\uACA0\uC5B4\uC694?"
        voice: {fileID: 0}
    - keywords:
      - reservation
      reply:
        english: Let me find your reservation. One moment, please.
        korean: "\uC608\uC57D\uC744 \uCC3E\uC544\uBCFC\uAC8C\uC694. \uC7A0\uC2DC\uB9CC
          \uAE30\uB2E4\uB824 \uC8FC\uC138\uC694."
        voice: {fileID: 0}
    - keywords:
      - thank
      reply:
        english: My pleasure. Enjoy your stay!
        korean: "\uCC9C\uB9CC\uC5D0\uC694. \uD3B8\uD788 \uC26C\uB2E4 \uAC00\uC138\uC694!"
        voice: {fileID: 0}
    defaultReply:
      english: I see. How else can I help you?
      korean: "\uADF8\uB807\uAD70\uC694. \uB354 \uB3C4\uC640\uB4DC\uB9B4 \uC77C\uC774
        \uC788\uC744\uAE4C\uC694?"
      voice: {fileID: 0}
    exampleSentence: I'd like to check in, please.
  - npcCode: SHOP_STAFF
    npcName: Alex
    roleLabel: "\uB4DC\uB7ED\uC2A4\uD1A0\uC5B4 \uC9C1\uC6D0"
    opening:
      english: Hi! Welcome to the drugstore. Can I help you find something?
      korean: "\uC548\uB155\uD558\uC138\uC694! \uB4DC\uB7ED\uC2A4\uD1A0\uC5B4\uC5D0
        \uC624\uC2E0 \uAC78 \uD658\uC601\uD574\uC694. \uCC3E\uC73C\uC2DC\uB294 \uBB3C\uAC74\uC774
        \uC788\uB098\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - umbrella
      reply:
        english: Umbrellas are right by the door. They're 8 coins each.
        korean: "\uC6B0\uC0B0\uC740 \uBB38 \uBC14\uB85C \uC606\uC5D0 \uC788\uC5B4\uC694.
          \uD558\uB098\uC5D0 8\uCF54\uC778\uC774\uC5D0\uC694."
        voice: {fileID: 0}
    - keywords:
      - card
      reply:
        english: Sure, we take cards. Please tap it here.
        korean: "\uB124, \uCE74\uB4DC \uB3FC\uC694. \uC5EC\uAE30\uC5D0 \uB300 \uC8FC\uC138\uC694."
        voice: {fileID: 0}
    - keywords:
      - thank
      reply:
        english: You're welcome! Stay dry out there.
        korean: "\uCC9C\uB9CC\uC5D0\uC694! \uBE44 \uB9DE\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD558\uC138\uC694."
        voice: {fileID: 0}
    defaultReply:
      english: Sure. Is there anything else you need?
      korean: "\uB124. \uB354 \uD544\uC694\uD55C \uAC74 \uC5C6\uC73C\uC138\uC694?"
      voice: {fileID: 0}
    exampleSentence: Do you sell umbrellas?
  - npcCode: TAXI_DRIVER
    npcName: Joe
    roleLabel: "\uD0DD\uC2DC \uAE30\uC0AC"
    opening:
      english: Hi there! Where are you headed?
      korean: "\uC548\uB155\uD558\uC138\uC694! \uC5B4\uB514\uB85C \uAC00\uC138\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - hotel
      reply:
        english: The hotel? It's just up the street. Hop in!
        korean: "\uD638\uD154\uC774\uC694? \uC774 \uAE38 \uBC14\uB85C \uC704\uCABD\uC774\uC5D0\uC694.
          \uD0C0\uC138\uC694!"
        voice: {fileID: 0}
    - keywords:
      - thank
      reply:
        english: You're welcome! Have a nice day.
        korean: "\uCC9C\uB9CC\uC5D0\uC694! \uC88B\uC740 \uD558\uB8E8 \uBCF4\uB0B4\uC138\uC694."
        voice: {fileID: 0}
    defaultReply:
      english: Sure. Please fasten your seat belt.
      korean: "\uC54C\uACA0\uC5B4\uC694. \uC548\uC804\uBCA8\uD2B8\uB97C \uB9E4 \uC8FC\uC138\uC694."
      voice: {fileID: 0}
    exampleSentence: Can you take me to the hotel, please?
  - npcCode: POLICE_OFFICER
    npcName: Dan
    roleLabel: "\uACBD\uCC30\uAD00"
    opening:
      english: Hello, this is the Maple Town police. What happened?
      korean: "\uC548\uB155\uD558\uC138\uC694, \uBA54\uC774\uD50C \uD0C0\uC6B4 \uACBD\uCC30\uC785\uB2C8\uB2E4.
        \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB098\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - stolen
      - lost
      - accident
      reply:
        english: I see. A patrol car is heading out right away.
        korean: "\uC54C\uACA0\uC5B4\uC694. \uC21C\uCC30\uCC28\uAC00 \uBC14\uB85C
          \uCD9C\uB3D9\uD560\uAC8C\uC694."
        voice: {fileID: 0}
    - keywords:
      - thank
      reply:
        english: You're welcome. Stay safe.
        korean: "\uCC9C\uB9CC\uC5D0\uC694. \uC870\uC2EC\uD788 \uB2E4\uB2C8\uC138\uC694."
        voice: {fileID: 0}
    defaultReply:
      english: Can you tell me what happened and where?
      korean: "\uBB34\uC2A8 \uC77C\uC774 \uC5B4\uB514\uC11C \uC788\uC5C8\uB294\uC9C0
        \uB9D0\uD574 \uC904\uB798\uC694?"
      voice: {fileID: 0}
    exampleSentence: My wallet was stolen at the diner.
  - npcCode: POST_OFFICE_STAFF
    npcName: Linda
    roleLabel: "\uC6B0\uCCB4\uAD6D \uC9C1\uC6D0"
    opening:
      english: Hello, welcome to the post office. What can I do for you?
      korean: "\uC548\uB155\uD558\uC138\uC694, \uC6B0\uCCB4\uAD6D\uC785\uB2C8\uB2E4.
        \uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - stamp
      reply:
        english: A stamp for a letter is one dollar.
        korean: "\uD3B8\uC9C0\uC6A9 \uC6B0\uD45C\uB294 1\uB2EC\uB7EC\uC608\uC694."
        voice: {fileID: 0}
    - keywords:
      - package
      reply:
        english: Please put it on the scale. Sending a package is five dollars.
        korean: "\uC800\uC6B8\uC5D0 \uC62C\uB824 \uC8FC\uC138\uC694. \uC18C\uD3EC\uB294
          5\uB2EC\uB7EC\uC608\uC694."
        voice: {fileID: 0}
    defaultReply:
      english: Would you like to send a letter or a package?
      korean: "\uD3B8\uC9C0\uB97C \uBCF4\uB0B4\uC138\uC694, \uC18C\uD3EC\uB97C \uBCF4\uB0B4\uC138\uC694?"
      voice: {fileID: 0}
    exampleSentence: I'd like to send this package.
  - npcCode: DINER_STAFF
    npcName: Rosa
    roleLabel: "\uC2DD\uB2F9 \uC885\uC5C5\uC6D0"
    opening:
      english: Hi, honey! Welcome to Maple Diner. What can I get you?
      korean: "\uC5B4\uC11C \uC640\uC694! \uBA54\uC774\uD50C \uB2E4\uC774\uB108\uC608\uC694.
        \uBB58 \uB4DC\uB9B4\uAE4C\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - pancake
      reply:
        english: Pancakes, great choice! That's seven dollars.
        korean: "\uD32C\uCF00\uC774\uD06C, \uC88B\uC740 \uC120\uD0DD\uC774\uC5D0\uC694!
          7\uB2EC\uB7EC\uC608\uC694."
        voice: {fileID: 0}
    - keywords:
      - coffee
      reply:
        english: Coffee is two dollars, and refills are free.
        korean: "\uCEE4\uD53C\uB294 2\uB2EC\uB7EC\uACE0 \uB9AC\uD544\uC740 \uBB34\uB8CC\uC608\uC694."
        voice: {fileID: 0}
    defaultReply:
      english: We have pancakes, burgers, apple pie and coffee.
      korean: "\uD32C\uCF00\uC774\uD06C, \uBC84\uAC70, \uC560\uD50C\uD30C\uC774,
        \uCEE4\uD53C\uAC00 \uC788\uC5B4\uC694."
      voice: {fileID: 0}
    exampleSentence: Can I have pancakes and coffee, please?
  - npcCode: BANK_STAFF
    npcName: Henry
    roleLabel: "\uC740\uD589\uC6D0"
    opening:
      english: Hello. Welcome to Town Bank. How may I help you today?
      korean: "\uC548\uB155\uD558\uC138\uC694. \uD0C0\uC6B4 \uC740\uD589\uC785\uB2C8\uB2E4.
        \uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - account
      reply:
        english: To open an account, I'll need a photo ID, please.
        korean: "\uACC4\uC88C\uB97C \uB9CC\uB4E4\uB824\uBA74 \uC0AC\uC9C4\uC774 \uC788\uB294
          \uC2E0\uBD84\uC99D\uC774 \uD544\uC694\uD574\uC694."
        voice: {fileID: 0}
    - keywords:
      - atm
      reply:
        english: The ATM is just inside the entrance, on the left.
        korean: "ATM\uC740 \uB4E4\uC5B4\uC624\uC2DC\uBA74 \uBC14\uB85C \uC67C\uCABD\uC5D0
          \uC788\uC5B4\uC694."
        voice: {fileID: 0}
    defaultReply:
      english: I can help you with deposits and withdrawals.
      korean: "\uC785\uAE08\uACFC \uCD9C\uAE08\uC744 \uB3C4\uC640\uB4DC\uB9B4 \uC218
        \uC788\uC5B4\uC694."
      voice: {fileID: 0}
    exampleSentence: I'd like to open an account.
  - npcCode: LAUNDROMAT_STAFF
    npcName: Gus
    roleLabel: "\uBE68\uB798\uBC29 \uC8FC\uC778"
    opening:
      english: Hey there! Welcome to Suds. Got some laundry today?
      korean: "\uC548\uB155\uD558\uC138\uC694! \uC11C\uC988 \uBE68\uB798\uBC29\uC774\uC5D0\uC694.
        \uC624\uB298 \uBE68\uB798 \uC788\uC5B4\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - wash
      reply:
        english: A wash is three dollars and takes about thirty minutes.
        korean: "\uC138\uD0C1\uC740 3\uB2EC\uB7EC\uACE0 30\uBD84\uCBE4 \uAC78\uB824\uC694."
        voice: {fileID: 0}
    - keywords:
      - dry
      reply:
        english: The dryer is two dollars. It takes about forty minutes.
        korean: "\uAC74\uC870\uAE30\uB294 2\uB2EC\uB7EC\uC608\uC694. 40\uBD84\uCBE4
          \uAC78\uB824\uC694."
        voice: {fileID: 0}
    defaultReply:
      english: Put your clothes in, add the soap, and press start.
      korean: "\uC637\uACFC \uC138\uC81C\uB97C \uB123\uACE0 \uC2DC\uC791\uC744 \uB204\uB974\uBA74
        \uB3FC\uC694."
      voice: {fileID: 0}
    exampleSentence: How much is a wash?
  - npcCode: FLOWER_SHOP_STAFF
    npcName: Lily
    roleLabel: "\uAF43\uC9D1 \uC8FC\uC778"
    opening:
      english: Oh, hello. Welcome to Bloom Flowers. Who are the flowers for?
      korean: "\uC544, \uC548\uB155\uD558\uC138\uC694. \uBE14\uB8F8 \uD50C\uB77C\uC6CC\uC608\uC694.
        \uB204\uAD6C\uC5D0\uAC8C \uC904 \uAF43\uC778\uAC00\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - bouquet
      reply:
        english: A bouquet is fifteen dollars. Maybe roses or tulips?
        korean: "\uAF43\uB2E4\uBC1C\uC740 15\uB2EC\uB7EC\uC608\uC694. \uC7A5\uBBF8\uB098
          \uD2A4\uB9BD\uC740 \uC5B4\uB54C\uC694?"
        voice: {fileID: 0}
    - keywords:
      - rose
      reply:
        english: One rose is two dollars.
        korean: "\uC7A5\uBBF8 \uD55C \uC1A1\uC774\uB294 2\uB2EC\uB7EC\uC608\uC694."
        voice: {fileID: 0}
    defaultReply:
      english: We have roses, tulips, sunflowers and daisies today.
      korean: "\uC624\uB298\uC740 \uC7A5\uBBF8, \uD2A4\uB9BD, \uD574\uBC14\uB77C\uAE30,
        \uB370\uC774\uC9C0\uAC00 \uC788\uC5B4\uC694."
      voice: {fileID: 0}
    exampleSentence: I'd like a bouquet for my friend.
  - npcCode: BARBER_STAFF
    npcName: Tony
    roleLabel: "\uC774\uBC1C\uC0AC"
    opening:
      english: Hey, come on in! Take a seat. Haircut today?
      korean: "\uC5B4\uC11C \uC640\uC694! \uC549\uC73C\uC138\uC694. \uC624\uB298
        \uBA38\uB9AC \uC790\uB974\uAC8C\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - haircut
      reply:
        english: Sure! A haircut is twenty dollars. How short do you want it?
        korean: "\uC88B\uC544\uC694! \uCEE4\uD2B8\uB294 20\uB2EC\uB7EC\uC608\uC694.
          \uC5BC\uB9C8\uB098 \uC9E7\uAC8C \uD560\uAE4C\uC694?"
        voice: {fileID: 0}
    - keywords:
      - shave
      reply:
        english: A shave is ten dollars.
        korean: "\uBA74\uB3C4\uB294 10\uB2EC\uB7EC\uC608\uC694."
        voice: {fileID: 0}
    defaultReply:
      english: No appointment needed. Just tell me how you want it.
      korean: "\uC608\uC57D\uC740 \uD544\uC694 \uC5C6\uC5B4\uC694. \uC5B4\uB5BB\uAC8C
        \uD558\uACE0 \uC2F6\uC740\uC9C0\uB9CC \uB9D0\uD574 \uC918\uC694."
      voice: {fileID: 0}
    exampleSentence: Just a little shorter, please.
  - npcCode: BAKERY_STAFF
    npcName: Grace
    roleLabel: "\uC81C\uBE75\uC0AC"
    opening:
      english: Hello, dear! The croissants just came out of the oven.
      korean: "\uC5B4\uC11C \uC640\uC694! \uD06C\uB8E8\uC544\uC0C1\uC774 \uBC29\uAE08
        \uC624\uBE10\uC5D0\uC11C \uB098\uC654\uC5B4\uC694."
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - croissant
      reply:
        english: A croissant is three dollars. For here or to go?
        korean: "\uD06C\uB8E8\uC544\uC0C1\uC740 3\uB2EC\uB7EC\uC608\uC694. \uBA39\uACE0
          \uAC00\uC694, \uAC00\uC838\uAC00\uC694?"
        voice: {fileID: 0}
    - keywords:
      - bread
      reply:
        english: A loaf of bread is four dollars.
        korean: "\uBE75 \uD55C \uB369\uC774\uB294 4\uB2EC\uB7EC\uC608\uC694."
        voice: {fileID: 0}
    defaultReply:
      english: We have bread, croissants and chocolate cake today.
      korean: "\uC624\uB298\uC740 \uBE75, \uD06C\uB8E8\uC544\uC0C1, \uCD08\uCF5C\uB9BF
        \uCF00\uC774\uD06C\uAC00 \uC788\uC5B4\uC694."
      voice: {fileID: 0}
    exampleSentence: Can I have a croissant to go?
  - npcCode: ARCADE_STAFF
    npcName: Max
    roleLabel: "\uC624\uB77D\uC2E4 \uC9C1\uC6D0"
    opening:
      english: Hey! Welcome to Little Arcade! Wanna try the claw machine?
      korean: "\uC548\uB155! \uB9AC\uD2C0 \uC544\uCF00\uC774\uB4DC\uC608\uC694! \uC778\uD615
        \uBF51\uAE30 \uD574 \uBCFC\uB798\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - play
      reply:
        english: Move the claw with the stick, then press the button to drop it.
        korean: "\uB9C9\uB300\uB85C \uC9D1\uAC8C\uB97C \uC6C0\uC9C1\uC774\uACE0 \uBC84\uD2BC\uC744
          \uB20C\uB7EC \uB0B4\uB824\uC694."
        voice: {fileID: 0}
    - keywords:
      - much
      reply:
        english: One game is one dollar. No promises on the prize, though!
        korean: "\uD55C \uD310\uC5D0 1\uB2EC\uB7EC\uC608\uC694. \uC778\uD615\uC774
          \uBF51\uD790\uC9C0\uB294 \uC7A5\uB2F4 \uBABB \uD574\uC694!"
        voice: {fileID: 0}
    defaultReply:
      english: Pick a machine and give it a try!
      korean: "\uAE30\uACC4\uB97C \uD558\uB098 \uACE8\uB77C\uC11C \uD574 \uBD10\uC694!"
      voice: {fileID: 0}
    exampleSentence: How do I play the claw machine?
  - npcCode: HOME_STORE_STAFF
    npcName: Nina
    roleLabel: "\uB9E4\uC7A5 \uC9C1\uC6D0"
    opening:
      english: Hello, welcome to Home & Living. Which room are you shopping for?
      korean: "\uC548\uB155\uD558\uC138\uC694, \uD648 \uC564 \uB9AC\uBE59\uC785\uB2C8\uB2E4.
        \uC5B4\uB290 \uBC29\uC5D0 \uB458 \uBB3C\uAC74\uC744 \uCC3E\uC73C\uC138\uC694?"
      voice: {fileID: 0}
    guidedTurns: []
    keywordReplies:
    - keywords:
      - lamp
      reply:
        english: This lamp is thirty dollars. It would look nice in a bedroom.
        korean: "\uC774 \uB7A8\uD504\uB294 30\uB2EC\uB7EC\uC608\uC694. \uCE68\uC2E4\uC5D0
          \uC798 \uC5B4\uC6B8\uB824\uC694."
        voice: {fileID: 0}
    - keywords:
      - chair
      reply:
        english: The armchair is one hundred fifty dollars.
        korean: "\uC548\uB77D\uC758\uC790\uB294 150\uB2EC\uB7EC\uC608\uC694."
        voice: {fileID: 0}
    defaultReply:
      english: Take your time and look around.
      korean: "\uCC9C\uCC9C\uD788 \uB458\uB7EC\uBCF4\uC138\uC694."
      voice: {fileID: 0}
    exampleSentence: I'm looking for a lamp for my bedroom.
  - npcCode: CAFE_BARISTA
    npcName: Zoe
    roleLabel: "\uCE74\uD398 \uC9C1\uC6D0"
    opening:
      english: Hi! I'm Zoe. What can I make for you today?
      korean: "\uC548\uB155\uD558\uC138\uC694! \uC800\uB294 Zoe\uC608\uC694. \uC624\uB298
        \uBB34\uC5C7\uC744 \uB9CC\uB4E4\uC5B4 \uB4DC\uB9B4\uAE4C\uC694?"
    guidedTurns: []
    keywordReplies:
    - keywords:
      - latte
      reply:
        english: One latte coming up! Hot or iced?
        korean: "\uB77C\uD14C \uD558\uB098 \uBC14\uB85C \uB9CC\uB4E4\uC5B4 \uB4DC\uB9B4\uAC8C\uC694!
          \uB530\uB73B\uD55C \uAC78\uB85C\uC694, \uC544\uC774\uC2A4\uB85C\uC694?"
    - keywords:
      - much
      reply:
        english: A small coffee is three dollars.
        korean: "\uC791\uC740 \uCEE4\uD53C\uB294 3\uB2EC\uB7EC\uC608\uC694."
    defaultReply:
      english: Sure! Anything else?
      korean: "\uB124! \uB354 \uD544\uC694\uD55C \uAC74 \uC5C6\uC73C\uC138\uC694?"
    exampleSentence: Can I have a latte, please?
  - npcCode: CAFE_SERVER
    npcName: Leo
    roleLabel: "\uCE74\uD398 \uC9C1\uC6D0"
    opening:
      english: Hi, I'm Leo. Would you like a table by the window?
      korean: "\uC548\uB155\uD558\uC138\uC694, \uC800\uB294 Leo\uC608\uC694. \uCC3D\uAC00
        \uC790\uB9AC\uB85C \uB4DC\uB9B4\uAE4C\uC694?"
    guidedTurns: []
    keywordReplies:
    - keywords:
      - menu
      reply:
        english: Here's the menu. The muffins are fresh today.
        korean: "\uBA54\uB274\uD310 \uC5EC\uAE30 \uC788\uC5B4\uC694. \uC624\uB298
          \uBA38\uD540\uC774 \uAC13 \uB098\uC654\uC5B4\uC694."
    - keywords:
      - table
      reply:
        english: Sure, take any table you like.
        korean: "\uB124, \uC6D0\uD558\uC2DC\uB294 \uC790\uB9AC\uC5D0 \uC549\uC73C\uC138\uC694."
    defaultReply:
      english: Let me know when you're ready to order.
      korean: "\uC8FC\uBB38\uD558\uC2E4 \uB54C \uB9D0\uC500\uD574 \uC8FC\uC138\uC694."
    exampleSentence: Can I see the menu, please?
  - npcCode: HOTEL_RECEPTIONIST
    npcName: Owen
    roleLabel: "\uD638\uD154 \uC9C1\uC6D0"
    opening:
      english: Good evening! Welcome to Maple House. Are you checking in?
      korean: "\uC548\uB155\uD558\uC138\uC694! \uBA54\uC774\uD50C \uD558\uC6B0\uC2A4\uC5D0
        \uC624\uC2E0 \uAC78 \uD658\uC601\uD574\uC694. \uCCB4\uD06C\uC778\uD558\uC2DC\uB098\uC694?"
    guidedTurns: []
    keywordReplies:
    - keywords:
      - check
      reply:
        english: Sure. Can I have your name, please?
        korean: "\uB124. \uC131\uD568\uC744 \uC54C\uB824 \uC8FC\uC2DC\uACA0\uC5B4\uC694?"
    - keywords:
      - room
      reply:
        english: Your room is on the second floor. Here is your key.
        korean: "\uBC29\uC740 2\uCE35\uC774\uC5D0\uC694. \uC5F4\uC1E0 \uC5EC\uAE30
          \uC788\uC5B4\uC694."
    defaultReply:
      english: Let me know if you need anything.
      korean: "\uD544\uC694\uD55C \uAC8C \uC788\uC73C\uBA74 \uB9D0\uC500\uD574 \uC8FC\uC138\uC694."
    exampleSentence: I'd like to check in, please.
  - npcCode: HOTEL_CONCIERGE
    npcName: Walter
    roleLabel: "\uCEE8\uC2DC\uC5B4\uC9C0"
    opening:
      english: Good afternoon. I'm Walter, the concierge. Where would you like to
        go?
      korean: "\uC548\uB155\uD558\uC138\uC694. \uCEE8\uC2DC\uC5B4\uC9C0 Walter\uC785\uB2C8\uB2E4.
        \uC5B4\uB514\uC5D0 \uAC00\uACE0 \uC2F6\uC73C\uC138\uC694?"
    guidedTurns: []
    keywordReplies:
    - keywords:
      - restaurant
      reply:
        english: Maple Diner is a short walk up the main street.
        korean: "\uBA54\uC774\uD50C \uB2E4\uC774\uB108\uB294 \uD070\uAE38\uC744 \uB530\uB77C
          \uC870\uAE08\uB9CC \uAC78\uC73C\uBA74 \uC788\uC5B4\uC694."
    - keywords:
      - taxi
      reply:
        english: You can stop a yellow taxi on the main street.
        korean: "\uD070\uAE38\uC5D0\uC11C \uB178\uB780 \uD0DD\uC2DC\uB97C \uC138\uC6B8
          \uC218 \uC788\uC5B4\uC694."
    defaultReply:
      english: I'm happy to help with anything in town.
      korean: "\uB9C8\uC744\uC5D0\uC11C \uD544\uC694\uD55C \uAC74 \uBB34\uC5C7\uC774\uB4E0
        \uB3C4\uC640\uB4DC\uB9B4\uAC8C\uC694."
    exampleSentence: Can you recommend a restaurant?
  - npcCode: HOTEL_BELLHOP
    npcName: Diego
    roleLabel: "\uBCA8\uBCF4\uC774"
    opening:
      english: Hi! I'm Diego. Can I take your bags?
      korean: "\uC548\uB155\uD558\uC138\uC694! \uC800\uB294 Diego\uC608\uC694. \uC9D0\uC744
        \uB4E4\uC5B4 \uB4DC\uB9B4\uAE4C\uC694?"
    guidedTurns: []
    keywordReplies:
    - keywords:
      - bag
      reply:
        english: No problem. I'll bring them up to your room.
        korean: "\uADF8\uB7FC\uC694. \uBC29\uAE4C\uC9C0 \uAC00\uC838\uB2E4 \uB4DC\uB9B4\uAC8C\uC694."
    - keywords:
      - elevator
      reply:
        english: The elevator is right over there.
        korean: "\uC5D8\uB9AC\uBCA0\uC774\uD130\uB294 \uBC14\uB85C \uC800\uCABD\uC774\uC5D0\uC694."
    defaultReply:
      english: Just let me know if you need a hand.
      korean: "\uB3C4\uC6C0\uC774 \uD544\uC694\uD558\uBA74 \uB9D0\uC500\uB9CC \uD558\uC138\uC694."
    exampleSentence: Could you help me with my bags?
  - npcCode: HOTEL_NIGHT_MANAGER
    npcName: Clara
    roleLabel: "\uD638\uD154 \uC57C\uAC04 \uB9E4\uB2C8\uC800"
    opening:
      english: Good evening. I'm Clara, the night manager. How is your stay?
      korean: "\uC548\uB155\uD558\uC138\uC694. \uC57C\uAC04 \uB9E4\uB2C8\uC800 Clara\uC608\uC694.
        \uC9C0\uB0B4\uC2DC\uAE30 \uAD1C\uCC2E\uC73C\uC138\uC694?"
    guidedTurns: []
    keywordReplies:
    - keywords:
      - noise
      reply:
        english: I'm sorry about the noise. I'll take care of it right away.
        korean: "\uC18C\uC74C \uB54C\uBB38\uC5D0 \uBD88\uD3B8\uD558\uC168\uB2E4\uB2C8
          \uC8C4\uC1A1\uD574\uC694. \uBC14\uB85C \uCC98\uB9AC\uD560\uAC8C\uC694."
    - keywords:
      - late
      reply:
        english: The front desk is open all night.
        korean: "\uD504\uB7F0\uD2B8\uB294 \uBC24\uC0C8 \uC5F4\uB824 \uC788\uC5B4\uC694."
    defaultReply:
      english: Please call the front desk anytime.
      korean: "\uC5B8\uC81C\uB4E0 \uD504\uB7F0\uD2B8\uB85C \uC5F0\uB77D \uC8FC\uC138\uC694."
    exampleSentence: There is too much noise in my room.
  - npcCode: SHOP_PHARMACIST
    npcName: Hannah
    roleLabel: "\uC57D\uC0AC"
    opening:
      english: Hello, I'm Hannah, the pharmacist. How can I help you?
      korean: "\uC548\uB155\uD558\uC138\uC694, \uC57D\uC0AC Hannah\uC608\uC694. \uBB34\uC5C7\uC744
        \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
    guidedTurns: []
    keywordReplies:
    - keywords:
      - headache
      reply:
        english: This medicine is good for headaches. Take one after a meal.
        korean: "\uC774 \uC57D\uC774 \uB450\uD1B5\uC5D0 \uC88B\uC544\uC694. \uC2DD\uD6C4\uC5D0
          \uD55C \uC54C \uB4DC\uC138\uC694."
    - keywords:
      - cold
      reply:
        english: For a cold, get some rest and drink lots of water.
        korean: "\uAC10\uAE30\uC5D0\uB294 \uD479 \uC26C\uACE0 \uBB3C\uC744 \uB9CE\uC774
          \uB4DC\uC138\uC694."
    defaultReply:
      english: Tell me how you feel, and I'll find something for you.
      korean: "\uC5B4\uB514\uAC00 \uBD88\uD3B8\uD55C\uC9C0 \uB9D0\uC500\uD574 \uC8FC\uC2DC\uBA74
        \uB9DE\uB294 \uC57D\uC744 \uCC3E\uC544 \uB4DC\uB9B4\uAC8C\uC694."
    exampleSentence: I have a headache. What should I take?
  - npcCode: SHOP_NIGHT_CLERK
    npcName: Samuel
    roleLabel: "\uB4DC\uB7ED\uC2A4\uD1A0\uC5B4 \uC9C1\uC6D0"
    opening:
      english: Evening. I'm Samuel. We're open all night.
      korean: "\uC548\uB155\uD558\uC138\uC694. \uC800\uB294 Samuel\uC774\uC5D0\uC694.
        \uBC24\uC0C8 \uBB38\uC744 \uC5F4\uC5B4\uC694."
    guidedTurns: []
    keywordReplies:
    - keywords:
      - water
      reply:
        english: The water is in the fridge at the back.
        korean: "\uBB3C\uC740 \uB4A4\uCABD \uB0C9\uC7A5\uACE0\uC5D0 \uC788\uC5B4\uC694."
    - keywords:
      - much
      reply:
        english: That's two dollars.
        korean: "2\uB2EC\uB7EC\uC608\uC694."
    defaultReply:
      english: Take your time. I'm right here.
      korean: "\uCC9C\uCC9C\uD788 \uBCF4\uC138\uC694. \uC800\uB294 \uC5EC\uAE30 \uC788\uC5B4\uC694."
    exampleSentence: Where can I find some water?
  - npcCode: POLICE_SERGEANT
    npcName: Victor
    roleLabel: "\uACBD\uC0AC"
    opening:
      english: Good evening. I'm Sergeant Victor. What happened?
      korean: "\uC548\uB155\uD558\uC138\uC694. \uACBD\uC0AC Victor\uC785\uB2C8\uB2E4.
        \uBB34\uC2A8 \uC77C\uC774 \uC788\uC5C8\uB098\uC694?"
    guidedTurns: []
    keywordReplies:
    - keywords:
      - lost
      reply:
        english: Tell me where you saw it last.
        korean: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBCF8 \uACF3\uC744 \uB9D0\uC500\uD574
          \uC8FC\uC138\uC694."
    - keywords:
      - thank
      reply:
        english: You're welcome. Get home safely.
        korean: "\uCC9C\uB9CC\uC5D0\uC694. \uC870\uC2EC\uD788 \uB4E4\uC5B4\uAC00\uC138\uC694."
    defaultReply:
      english: I see. Please tell me more.
      korean: "\uADF8\uB807\uAD70\uC694. \uB354 \uC790\uC138\uD788 \uB9D0\uC500\uD574
        \uC8FC\uC138\uC694."
    exampleSentence: I lost my wallet.
  - npcCode: POLICE_PATROL_OFFICER
    npcName: Kevin
    roleLabel: "\uACBD\uCC30\uAD00"
    opening:
      english: Hi, I'm Officer Kevin. Is everything okay?
      korean: "\uC548\uB155\uD558\uC138\uC694, \uACBD\uCC30\uAD00 Kevin\uC774\uC5D0\uC694.
        \uBCC4\uC77C \uC5C6\uC73C\uC138\uC694?"
    guidedTurns: []
    keywordReplies:
    - keywords:
      - stolen
      reply:
        english: I'm sorry to hear that. Where did it happen?
        korean: "\uC548\uD0C0\uAE5D\uB124\uC694. \uC5B4\uB514\uC11C \uADF8\uB7AC\uB098\uC694?"
    - keywords:
      - patrol
      reply:
        english: I patrol the main street every evening.
        korean: "\uC800\uB294 \uB9E4\uC77C \uC800\uB141 \uD070\uAE38\uC744 \uC21C\uCC30\uD574\uC694."
    defaultReply:
      english: Okay. Let me write that down.
      korean: "\uC54C\uACA0\uC5B4\uC694. \uC801\uC5B4 \uB458\uAC8C\uC694."
    exampleSentence: My bag was stolen.
  - npcCode: POLICE_ROOKIE
    npcName: Tyler
    roleLabel: "\uC2E0\uC785 \uACBD\uCC30\uAD00"
    opening:
      english: Hello! I'm Tyler. I just started here. How can I help?
      korean: "\uC548\uB155\uD558\uC138\uC694! \uC800\uB294 Tyler\uC608\uC694. \uC5EC\uAE30
        \uB9C9 \uC654\uC5B4\uC694. \uBB34\uC5C7\uC744 \uB3C4\uC640\uB4DC\uB9B4\uAE4C\uC694?"
    guidedTurns: []
    keywordReplies:
    - keywords:
      - lost
      reply:
        english: Oh no! Let me check the lost and found box.
        korean: "\uC774\uB7F0! \uBD84\uC2E4\uBB3C \uC0C1\uC790\uB97C \uD655\uC778\uD574
          \uBCFC\uAC8C\uC694."
    - keywords:
      - thank
      reply:
        english: Anytime! Stay safe out there.
        korean: "\uC5B8\uC81C\uB4E0\uC9C0\uC694! \uC870\uC2EC\uD788 \uB2E4\uB2C8\uC138\uC694."
    defaultReply:
      english: Let me ask my sergeant about that.
      korean: "\uADF8\uAC74 \uACBD\uC0AC\uB2D8\uAED8 \uC5EC\uCB64\uBCFC\uAC8C\uC694."
    exampleSentence: I lost my phone.
  - npcCode: TOWN_RETIREE
    npcName: Ruby
    roleLabel: "\uD589\uC778"
    opening:
      english: Good morning, dear! Isn't it a lovely day?
      korean: "\uC88B\uC740 \uC544\uCE68\uC774\uC5D0\uC694! \uB0A0\uC528\uAC00 \uCC38
        \uC88B\uC8E0?"
    guidedTurns: []
    keywordReplies:
    - keywords:
      - weather
      reply:
        english: It's sunny and warm. Perfect for a walk.
        korean: "\uD587\uC0B4\uC774 \uB530\uB73B\uD574\uC11C \uAC77\uAE30\uC5D0 \uB531\uC774\uC5D0\uC694."
    - keywords:
      - teacher
      reply:
        english: Yes, I taught at the school here for thirty years.
        korean: "\uB124, \uC5EC\uAE30 \uD559\uAD50\uC5D0\uC11C 30\uB144 \uB3D9\uC548
          \uAC00\uB974\uCCE4\uC5B4\uC694."
    defaultReply:
      english: Oh, how nice!
      korean: "\uC5B4\uBA38, \uC88B\uB124\uC694!"
    exampleSentence: Yes, it's a beautiful day.
  - npcCode: TOWN_STUDENT
    npcName: Ethan
    roleLabel: "\uD589\uC778"
    opening:
      english: Hey! I'm Ethan. I'm a student here.
      korean: "\uC548\uB155\uD558\uC138\uC694! \uC800\uB294 Ethan\uC774\uC5D0\uC694.
        \uC5EC\uAE30\uC11C \uACF5\uBD80\uD574\uC694."
    guidedTurns: []
    keywordReplies:
    - keywords:
      - study
      reply:
        english: I study history. I have a big test next week.
        korean: "\uC5ED\uC0AC\uB97C \uACF5\uBD80\uD574\uC694. \uB2E4\uC74C \uC8FC\uC5D0
          \uD070 \uC2DC\uD5D8\uC774 \uC788\uC5B4\uC694."
    - keywords:
      - cafe
      reply:
        english: The corner cafe is my favorite place to study.
        korean: "\uAE38\uBAA8\uD241\uC774 \uCE74\uD398\uAC00 \uACF5\uBD80\uD558\uAE30
