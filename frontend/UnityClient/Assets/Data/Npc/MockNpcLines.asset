MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9200f7f4bfb6ae449a4da21565280631, type: 3}
  m_Name: MockNpcLines
  m_EditorClassIdentifier: A305.Npc::A305.Npc.MockNpcLineSource
  entries:
  - npcCode: TUTORIAL_PASSERBY
    greeting: Excuse me! Could you help me? I'm looking for the cafe.
  - npcCode: TOWN_PASSERBY
    greeting: Hi there! Nice weather today, isn't it?
  - npcCode: CAFE_STAFF
    greeting: "Hi there! Welcome to the corner caf\xE9. Would you like to order?"
  - npcCode: HOTEL_STAFF
    greeting: Good afternoon! Welcome to Maple House. Are you checking in?
  - npcCode: SHOP_STAFF
    greeting: Hi! Welcome to the drugstore. Can I help you find something?
  - npcCode: POLICE_OFFICER
    greeting: Hello, this is the Maple Town police. How can I help you?
  - npcCode: POST_OFFICE_STAFF
    greeting: Good morning. Are you sending something today?
  - npcCode: DINER_STAFF
    greeting: Hi, hon! Welcome to Maple Diner. Table for one?
  - npcCode: BANK_STAFF
    greeting: Good afternoon. Welcome to Town Bank. How may I help you?
  - npcCode: LAUNDROMAT_STAFF
    greeting: Hey there! Need a hand with the machines?
  - npcCode: FLOWER_SHOP_STAFF
    greeting: Oh, hello... Welcome to Bloom Flowers. Looking for anything special?
  - npcCode: BARBER_STAFF
    greeting: Hey! Come on in. Just a trim today?
  - npcCode: BAKERY_STAFF
    greeting: Good morning, dear! The bread just came out of the oven.
  - npcCode: ARCADE_STAFF
    greeting: Yo! Welcome to Little Arcade. Want to try the claw machine?
  - npcCode: HOME_STORE_STAFF
    greeting: Welcome to Home and Living. Feel free to look around.
  - npcCode: CAFE_BARISTA
    greeting: Hi! I'm on the espresso machine today. What can I make for you?
  - npcCode: CAFE_SERVER
    greeting: Hey there! Grab any table you like. I'll bring you a menu.
  - npcCode: HOTEL_RECEPTIONIST
    greeting: Good evening! Welcome to Maple House. Checking in?
  - npcCode: HOTEL_CONCIERGE
    greeting: Oh, hello... Welcome to Bloom Flowers. Looking for anything special?
  - npcCode: HOTEL_BELLHOP
    greeting: Hi! Can I help you with your bags?
  - npcCode: HOTEL_NIGHT_MANAGER
    greeting: Good evening. Is everything all right with your stay?
  - npcCode: SHOP_PHARMACIST
    greeting: Hello. Do you need any medicine today?
  - npcCode: SHOP_NIGHT_CLERK
    greeting: Evening. We're open all night if you need anything.
  - npcCode: POLICE_SERGEANT
    greeting: Good evening. This is the night desk. What can I do for you?
  - npcCode: POLICE_PATROL_OFFICER
    greeting: Hi there. Did something happen around here?
  - npcCode: POLICE_ROOKIE
    greeting: Good morning, dear! The bread just came out of the oven.
  - npcCode: TOWN_RETIREE
    greeting: Good morning. Are you sending something today?
  - npcCode: TOWN_STUDENT
    greeting: Yo! Welcome to Little Arcade. Want to try the claw machine?
  - npcCode: TOWN_EVENING_WALKER
    greeting: Good afternoon. Welcome to Town Bank. How may I help you?
  - npcCode: TOWN_SHOPPER
    greeting: Good afternoon. Welcome to Town Bank. How may I help you?
  - npcCode: TOWN_HANDYMAN
    greeting: Welcome to Home and Living. Feel free to look around.
  - npcCode: FIRE_CAPTAIN
    greeting: Hi, hon! Welcome to Maple Diner. Table for one?
  - npcCode: FIRE_FIGHTER
    greeting: Hey there! Need a hand with the machines?
  - npcCode: FIRE_ROOKIE
    greeting: Hey! Come on in. Just a trim today?
  - npcCode: TOWN_GRANDFATHER
    greeting: Good morning. Nice weather for a walk.
  - npcCode: TOWN_GRANDMOTHER
    greeting: Oh, good morning! We take our walk every morning. Isn't it lovely?
