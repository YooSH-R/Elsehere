--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7e6a1767bc518be40a0290af674b8626, type: 3}
  m_Name: TutorialGuide
  m_EditorClassIdentifier: A305.Tutorial::A305.Tutorial.TutorialGuideDefinition
  homeSceneName: HomeScene
  tutorialNpcCode: TOWN_PASSERBY
  tutorialScriptKey: TUTORIAL_PASSERBY
  stepGuides:
  - step: 0
    title: "\uC5EC\uD589 \uCCAB\uB0A0 \xB7 \uC219\uC18C\uC5D0 \uB3C4\uCC29\uD588\uC5B4\uC694"
    body: "\uC624\uB298 \uC774 \uB9C8\uC744\uC5D0 \uB9C9 \uB3C4\uCC29\uD588\uC5B4\uC694.
      \uBC16\uC73C\uB85C \uB098\uAC00\uAE30 \uC804\uC5D0 \uC219\uC18C\uC5D0\uC11C
      \uC6C0\uC9C1\uC774\uB294 \uBC95\uACFC \uC601\uC5B4 \uB2E8\uC5B4\uB97C \uBAA8\uC73C\uB294
      \uBC95\uC744 \uC775\uD600 \uBD10\uC694."
    task: 
    buttonLabel: "\uC2DC\uC791\uD558\uAE30"
  - step: 1
    title: "\uC219\uC18C \uB458\uB7EC\uBCF4\uAE30 1/5 \xB7 \uAC78\uC5B4 \uBCF4\uAE30"
    body: "WASD\uB098 \uBC29\uD5A5\uD0A4\uB85C \uAC77\uACE0, Shift\uB97C \uB204\uB978
      \uCC44 \uAC78\uC73C\uBA74 \uB2EC\uB824\uC694. \uD734\uB300\uD3F0\uC5D0\uC11C\uB294
      \uC67C\uCABD \uC544\uB798 \uC870\uC774\uC2A4\uD2F1\uC744 \uBC00\uC5B4\uC694."
    task: "\uC219\uC18C \uC548\uC744 \uAC78\uC5B4 \uBCF4\uC138\uC694."
    buttonLabel: "\uB2E4\uC74C\uC73C\uB85C"
  - step: 2
    title: "\uC219\uC18C \uB458\uB7EC\uBCF4\uAE30 2/5 \xB7 \uB458\uB7EC\uBCF4\uAE30"
    body: "\uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC744 \uB204\uB978 \uCC44
      \uB04C\uBA74 \uC8FC\uC704\uB97C \uB458\uB7EC\uBD10\uC694. \uD720\uB85C \uAC00\uAE4C\uC774\xB7\uBA40\uB9AC
      \uBCF4\uACE0, V\uB85C 1\uC778\uCE6D\uACFC 3\uC778\uCE6D\uC744 \uBC14\uAFD4\uC694.
      \uD734\uB300\uD3F0\uC5D0\uC11C\uB294 \uD654\uBA74\uC744 \uC190\uAC00\uB77D\uC73C\uB85C
      \uB04C\uC5B4\uC694."
    task: "\uB9C8\uC6B0\uC2A4\uB97C \uB04C\uC5B4 \uC8FC\uC704\uB97C \uB458\uB7EC\uBCF4\uC138\uC694."
    buttonLabel: "\uB2E4\uC74C\uC73C\uB85C"
  - step: 3
    title: "\uC219\uC18C \uB458\uB7EC\uBCF4\uAE30 3/5 \xB7 \uC0AC\uBB3C \uB2E8\uC5B4
      \uBAA8\uC73C\uAE30"
    body: "\uBA48\uCDB0 \uC11C\uC11C \uAC00\uAD6C\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C
      \uC62C\uB9AC\uBA74 \uC601\uC5B4 \uB2E8\uC5B4 \uCE74\uB4DC\uAC00 \uB5A0\uC694.
      \uAC00\uAD6C\uB97C \uD074\uB9AD\uD558\uBA74(\uD734\uB300\uD3F0\uC740 \uB204\uB974\uBA74)
      \uCE74\uB4DC\uAC00 \uACE0\uC815\uB418\uACE0 \uC608\uBB38\xB7[\uBC1C\uC74C \uB4E3\uAE30]\xB7[\uC800\uC7A5]\uC744
      \uC4F8 \uC218 \uC788\uC5B4\uC694."
    task: "\uAC00\uAD6C\uB97C \uD074\uB9AD\uD574 \uCE74\uB4DC\uB97C \uACE0\uC815\uD558\uACE0
      [\uC800\uC7A5]\uC744 \uB20C\uB7EC \uBCF4\uC138\uC694."
    buttonLabel: 
  - step: 4
    title: "\uC219\uC18C \uB458\uB7EC\uBCF4\uAE30 4/5 \xB7 \uB2E8\uC5B4\uC7A5 \uC5F4\uAE30"
    body: "\uC800\uC7A5\uD55C \uB2E8\uC5B4\uB294 \uB2E8\uC5B4\uC7A5\uC5D0 \uBAA8\uC5EC\uC694.
      \uC624\uB978\uCABD \uC704 \uBA54\uB274(\u2261)\uC5D0\uB294 [\uB2E8\uC5B4\uC7A5],
      \uC9C0\uB09C \uB300\uD654\uB97C \uB2E4\uC2DC \uBCF4\uB294 [\uD53C\uB4DC\uBC31
      \uBAA9\uB85D], \uC219\uC18C\uB85C \uB3CC\uC544\uC624\uB294 [\uD648]\uC774 \uC788\uC5B4\uC694."
    task: "\u2261\uB97C \uB204\uB974\uACE0 [\uB2E8\uC5B4\uC7A5]\uC744 \uC5F4\uC5B4
      \uBCF4\uC138\uC694."
    buttonLabel: 
  - step: 5
    title: "\uC219\uC18C \uB458\uB7EC\uBCF4\uAE30 5/5 \xB7 \uC774\uC81C \uBC16\uC73C\uB85C"
    body: "\uC219\uC18C \uBB38\uC774 \uC5F4\uB838\uC5B4\uC694. \uBB38 \uC55E\uC5D0\uC11C
      \uB204\uAD70\uAC00 \uAE38\uC744 \uD5E4\uB9E4\uACE0 \uC788\uB294 \uAC83 \uAC19\uC544\uC694."
    task: "\uD45C\uC2DC\uB41C \uBB38\uC73C\uB85C \uB098\uAC00 \uBCF4\uC138\uC694."
    buttonLabel: 
  - step: 6
    title: "Ben \uB9CC\uB098\uAE30"
    body: "\uBA38\uB9AC \uC704\uC5D0 \uD45C\uC2DC\uAC00 \uC788\uB294 \uC0AC\uB78C\uC774
      Ben\uC774\uC5D0\uC694. Ben\uB3C4 \uC774 \uB9C8\uC744\uC5D0 \uB9C9 \uC640\uC11C
      \uCE74\uD398\uB97C \uCC3E\uACE0 \uC788\uC5B4\uC694. \uAC00\uAE4C\uC774 \uAC00\uBA74
      \uB9D0\uC744 \uAC78\uC5B4\uC640\uC694."
    task: "Ben\uC5D0\uAC8C \uB2E4\uAC00\uAC00 [\uB300\uD654\uD558\uAE30]\uB97C \uB20C\uB7EC\uC694."
    buttonLabel: 
  - step: 8
    title: "\uCCAB \uB300\uD654, \uD574\uB0C8\uC5B4\uC694!"
    body: "\uD53C\uB4DC\uBC31\uC5D0\uC11C \uC798\uD55C \uC810\uACFC \uB354 \uC790\uC5F0\uC2A4\uB7EC\uC6B4
      \uD45C\uD604\uC744 \uD655\uC778\uD574\uC694. \uC9C0\uB09C \uD53C\uB4DC\uBC31\uC740
      \u2261 \uBA54\uB274\uC758 [\uD53C\uB4DC\uBC31 \uBAA9\uB85D]\uC5D0\uC11C \uB2E4\uC2DC
      \uBCFC \uC218 \uC788\uC5B4\uC694."
    task: "\uB2E4 \uC77D\uC5C8\uC73C\uBA74 \uD53C\uB4DC\uBC31\uC758 [\uB2EB\uAE30]\uB97C
      \uB20C\uB7EC\uC694."
    buttonLabel: 
  - step: 9
    title: "\uC624\uB298\uC758 \uBAA9\uD45C \uD655\uC778\uD558\uAE30"
    body: "\uC67C\uCABD \uC704 \uC9C0\uB3C4 \uBC84\uD2BC\uC744 \uB204\uB974\uBA74
      \uB9C8\uC744 \uC9C0\uB3C4\uC640 \uC624\uB298\uC758 \uC5EC\uC815\uC774 \uB2F4\uAE34
      \uC218\uCCA9\uC774 \uC5F4\uB824\uC694. \uBA40\uB9AC \uAC08 \uB550 \uAE38\uAC00\uC5D0\uC11C
      [\uD0DD\uC2DC \uC138\uC6B0\uAE30]\uB97C, \uC26C\uACE0 \uC2F6\uC73C\uBA74 \uBCA4\uCE58\uC5D0\uC11C
      [\uC7A0\uAE50 \uC549\uAE30]\uB97C \uB20C\uB7EC\uC694."
    task: "\uC9C0\uB3C4 \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC624\uB298\uC758 \uBAA9\uD45C\uB97C
      \uD655\uC778\uD574 \uBCF4\uC138\uC694."
    buttonLabel: 
  talkOfferCaption: "Ben\uC774 \uB9D0\uC744 \uAC78\uC5B4\uC654\uC5B4\uC694. [\uB300\uD654\uD558\uAE30]\uB97C
    \uB20C\uB7EC \uC774\uC57C\uAE30\uB97C \uC2DC\uC791\uD574\uC694."
  guidedLineCaption: "\uD29C\uD1A0\uB9AC\uC5BC \uB300\uD654\uB294 \uC815\uD574\uC9C4
    \uB300\uC0AC\uB85C \uC5F0\uC2B5\uD574\uC694. \uC544\uB798 \uBB38\uC7A5\uC744
    \uADF8\uB300\uB85C \uC785\uB825\uD558\uACE0 [\uBCF4\uB0B4\uAE30]\uB97C \uB20C\uB7EC\uC694.
    \uB9C8\uC744 \uB300\uD654\uBD80\uD130\uB294 \uC790\uC720\uB86D\uAC8C \uB9D0\uD574\uC694."
  dialogueEndCaption: "\uAE38 \uC548\uB0B4\uB97C \uB9C8\uCCE4\uC5B4\uC694. [\uB300\uD654
    \uC885\uB8CC]\uB97C \uB204\uB974\uBA74 \uD53C\uB4DC\uBC31\uC744 \uBCFC \uC218
    \uC788\uC5B4\uC694."
  travelLockedMessage: "\uC544\uC9C1 \uB2E4\uB978 \uACF3\uC73C\uB85C \uAC08 \uC218
    \uC5C6\uC5B4\uC694. \uC548\uB0B4 \uCE74\uB4DC\uC758 \uD560 \uC77C\uC744 \uBA3C\uC800
    \uD574 \uBCF4\uC138\uC694."
