  stepGuides:
  - step: 0
    title: "\uC5EC\uD589 \uC2DC\uC791"
    task: "\uC219\uC18C\uC5D0\uC11C \uAE30\uBCF8 \uC870\uC791\uBD80\uD130 \uC775\uD600
      \uBCFC\uAE4C\uC694?"
    touchTask: 
    buttonLabel: "\uC2DC\uC791\uD558\uAE30"
  - step: 1
    title: "\uAC77\uAE30"
    task: "{WASD} \uAC77\uAE30 \xB7 {Shift} \uB6F0\uAE30 \xB7 {\uC2A4\uD398\uC774\uC2A4}
      \uC810\uD504"
    touchTask: "\uC67C\uCABD \uC544\uB798 {\uC870\uC774\uC2A4\uD2F1}\uC744 \uBC00\uC5B4
      \uAC77\uAE30"
    buttonLabel: 
  - step: 2
    title: "\uB458\uB7EC\uBCF4\uAE30"
    task: "{\uB9C8\uC6B0\uC2A4 \uC67C\uCABD} \uB204\uB978 \uCC44 \uB04C\uAE30 \xB7
      {\uD720} \uC90C \xB7 {V} \uC2DC\uC810"
    touchTask: "\uD654\uBA74 \uC624\uB978\uCABD\uC744 \uB04C\uC5B4 \uB458\uB7EC\uBCF4\uAE30"
    buttonLabel: 
  - step: 3
    title: "\uB2E8\uC5B4 \uBAA8\uC73C\uAE30"
    task: "\uAC00\uAD6C\uB97C \uD074\uB9AD\uD574 \uCE74\uB4DC \uACE0\uC815 \u2192
      {\uB2E8\uC5B4\uC7A5\uC5D0 \uC800\uC7A5}"
    touchTask: "\uAC00\uAD6C\uB97C \uB20C\uB7EC \uCE74\uB4DC \uACE0\uC815 \u2192
      {\uB2E8\uC5B4\uC7A5\uC5D0 \uC800\uC7A5}"
    buttonLabel: 
  - step: 4
    title: "\uB2E8\uC5B4\uC7A5"
    task: "\uC624\uB978\uCABD \uC704 {\uD734\uB300\uD3F0}\uC5D0\uC11C {\uB2E8\uC5B4\uC7A5}
      \uC5F4\uAE30"
    touchTask: 
    buttonLabel: 
  - step: 5
    title: "\uBC16\uC73C\uB85C"
    task: "\uD654\uC0B4\uD45C\uAC00 \uAC00\uB9AC\uD0A4\uB294 \uBB38\uC73C\uB85C \uB098\uAC00\uAE30"
    touchTask: 
    buttonLabel: 
  - step: 6
    title: "Ben \uB9CC\uB098\uAE30"
    task: "\uAE38\uC744 \uD5E4\uB9E4\uB294 Ben\uC774 \uB2E4\uAC00\uC624\uBA74 {\uB300\uD654\uD558\uAE30}"
    touchTask: 
    buttonLabel: 
  - step: 8
    title: "\uD53C\uB4DC\uBC31"
    task: "\uD53C\uB4DC\uBC31\uC744 \uC77D\uACE0 {X}\uB85C \uB2EB\uAE30"
    touchTask: 
    buttonLabel: 
  - step: 9
    title: "\uC624\uB298\uC758 \uBAA9\uD45C"
    task: "\uC67C\uCABD \uC704 {\uD018\uC2A4\uD2B8}\uB97C \uB20C\uB7EC \uC624\uB298\uC758
      \uBAA9\uD45C \uBCF4\uAE30"
    touchTask: 
    buttonLabel: 
  talkOfferCaption: "{\uB300\uD654\uD558\uAE30}\uB97C \uB20C\uB7EC Ben\uACFC \uC774\uC57C\uAE30\uD574\uC694"
  dialogueLinesCaption: "Ben\uC774 \uBA3C\uC800 \uB9D0\uC744 \uAC78\uC5C8\uC5B4\uC694.
    \uC8FC\uACE0\uBC1B\uC740 \uB300\uD654\uB294 \uC5EC\uAE30\uC5D0 \uC313\uC5EC\uC694"
  dialogueToolsCaption: "Ben\uC758 \uB9D0\uC740 {\uC790\uB9C9 \uCF1C\uAE30}\uB85C
    \uAE00\uC790\uB85C \uBCF4\uACE0 {\uB2E4\uC2DC \uB4E3\uAE30}\uB85C \uB2E4\uC2DC
    \uB4E4\uC5B4\uC694. \uC5B4\uB824\uC6B0\uBA74 {\uB73B}\uC73C\uB85C \uD55C\uAD6D\uC5B4
    \uB73B\uC744 \uBD10\uC694"
  suggestedWordsCaption: "{\uB2E8\uC5B4}\uC5D0\uB294 \uB300\uB2F5\uC5D0 \uC4F8 \uB9CC\uD55C
    \uCD94\uCC9C \uB2E8\uC5B4\uAC00 \uB098\uC640\uC694"
  suggestedSentenceCaption: "\uB300\uB2F5\uC774 \uB5A0\uC624\uB974\uC9C0 \uC54A\uC73C\uBA74
    {\uD78C\uD2B8}\uB85C {\uCD94\uCC9C \uBB38\uC7A5}\uC744 \uD3BC\uCCD0 \uBD10\uC694.
    \uD3BC\uCE5C \uBB38\uC7A5\uC744 \uB204\uB974\uBA74 \uC785\uB825\uCE78\uC5D0 \uB4E4\uC5B4\uAC00\uC694"
  vocabularyButtonCaption: "{\uB2E8\uC5B4\uC7A5}\uC744 \uB20C\uB7EC \uC5F4\uC5B4\uC694"
  guidedLineCaption: "\uD29C\uD1A0\uB9AC\uC5BC\uC740 \uC815\uD574\uC9C4 \uD750\uB984\uB300\uB85C
    \uC9C4\uD589\uB3FC\uC694. \uC774 \uB300\uC0AC\uB97C {\uB9D0\uD558\uAE30}\uB85C
    \uB9D0\uD558\uAC70\uB098 \uC785\uB825\uD558\uACE0 {\uBCF4\uB0B4\uAE30}"
  guidedLineMissCaption: "\uD29C\uD1A0\uB9AC\uC5BC\uC740 \uC815\uD574\uC9C4 \uD750\uB984\uB300\uB85C
    \uC9C4\uD589\uB3FC\uC694. \uC774 \uB300\uC0AC\uC640 \uAC19\uAC8C \uC785\uB825\uD558\uAC70\uB098
    {\uD78C\uD2B8}\uB85C \uD3BC\uCE5C \uBB38\uC7A5\uC744 \uB20C\uB7EC \uB123\uC5B4\uC694"
  voiceLightCaption: "\uCD08\uB85D\uBD88\uC774 \uCF1C\uC9C0\uBA74 \uBAA9\uC18C\uB9AC\uAC00
    \uC798 \uB4E4\uB9AC\uACE0 \uC788\uC5B4\uC694. \uBD88\uC774 \uD750\uB9AC\uBA74
    \uC870\uAE08 \uB354 \uD06C\uAC8C \uB9D0\uD574 \uBCF4\uC138\uC694."
  dialogueEndCaption: "\uAE38 \uC548\uB0B4\uB97C \uB9C8\uCCE4\uC5B4\uC694! {\uB300\uD654
    \uC885\uB8CC}\uB97C \uB204\uB974\uBA74 Ben\uACFC \uB098\uB208 \uB300\uD654\uB97C
    \uB3CC\uC544\uBCF4\uB294 \uD53C\uB4DC\uBC31\uC744 \uBCFC \uC218 \uC788\uC5B4\uC694"
  feedbackSectionsCaption: "Ben\uACFC \uB098\uB208 \uB300\uD654\uB97C \uB3CC\uC544\uBCF4\uB294
    \uB300\uD654 \uD53C\uB4DC\uBC31\uC774\uC5D0\uC694. \uD0ED\uC744 \uB20C\uB7EC
    {\uC694\uC57D}\xB7{\uBB38\uC7A5 \uAD50\uC815}\xB7{\uC804\uCCB4 \uB300\uD654}\uB97C
    \uBD10\uC694"
  feedbackPagesCaption: "\uD45C\uD604\uACFC \uC694\uC57D\uC774 \uAE38\uBA74 \uC774
    \uC601\uC5ED\uC744 \uC704\uC544\uB798\uB85C \uC2A4\uD06C\uB864\uD574 \uBCF4\uC138\uC694"
  feedbackCloseCaption: "\uB2E4 \uBD24\uC73C\uBA74 \uC624\uB978\uCABD \uC704 {X}\uB85C
    \uB2EB\uC544\uC694. \uC774\uC5B4\uC11C \uC624\uB298\uC758 \uBAA9\uD45C\uB97C
    \uC54C\uB824 \uB4DC\uB824\uC694"
  vocabularyCaption: "\uB2E8\uC5B4\uC7A5\uC5D0\uB294 \uC0AC\uBB3C \uCE74\uB4DC\uB098
    \uB300\uD654\uC5D0\uC11C \uC800\uC7A5\uD55C \uB2E8\uC5B4\xB7\uD45C\uD604\uC774
    \uBAA8\uC5EC\uC694. \uB73B\xB7\uC608\uBB38\uC744 \uB2E4\uC2DC \uBCF4\uACE0 {\uC678\uC6E0\uC5B4\uC694}\xB7\uBA54\uBAA8\uB85C
    \uC815\uB9AC\uD574\uC694\n\uB2E4 \uBD24\uC73C\uBA74 \uC624\uB978\uCABD \uC704
    {X}\uB85C \uB2EB\uACE0 \uBC16\uC73C\uB85C \uB098\uAC00\uC694"
  relationshipCaption: "<b>Ben\uACFC \uC870\uAE08 \uCE5C\uD574\uC84C\uC5B4\uC694!</b>\n\uC88B\uC740
    \uB9D0\uC744 \uD558\uBA74 \uC774\uB984 \uC606 \uD558\uD2B8(\uD638\uAC10\uB3C4)\uAC00
    \uC624\uB974\uACE0, \uBB34\uB840\uD55C \uB9D0\uC744 \uD558\uBA74 \uACBD\uACE0\uAC00
    \uC313\uC5EC\uC694. \uAE38 \uC548\uB0B4\uB97C \uB9C8\uCE58\uBA74 \uD638\uAC10\uB3C4\uC640
    \uC774 \uB9CC\uB0A8\uC774 \uC800\uC7A5\uB3FC\uC694."
  travelLockedMessage: "\uC544\uC9C1 \uB2E4\uB978 \uACF3\uC73C\uB85C \uAC08 \uC218
    \uC5C6\uC5B4\uC694. \uD560 \uC77C\uBD80\uD130 \uD574 \uC8FC\uC138\uC694."
