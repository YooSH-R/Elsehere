  m_Script: {fileID: 11500000, guid: 7e6a1767bc518be40a0290af674b8626, type: 3}
  m_Name: TutorialGuide
  m_EditorClassIdentifier: A305.Tutorial::A305.Tutorial.TutorialGuideDefinition
  homeSceneName: HomeScene
  tutorialNpcCode: TUTORIAL_PASSERBY
  missionNpcCode: CAFE_STAFF
  stepGuides:
  - step: 0
    title: "\uCCAB\uAC78\uC74C \uAC00\uC774\uB4DC 1/4 \xB7 \uC6B0\uB9AC \uC9D1\uC5D0
      \uC624\uC2E0 \uAC78 \uD658\uC601\uD574\uC694"
    body: "\uC774 \uC791\uC740 \uB9C8\uC744\uC5D0\uC11C \uAE38\uC7A1\uC774\uAC00
      \uB418\uC5B4 \uC904\uAC8C\uC694. \uC0AC\uBB3C\uC744 \uBC1C\uACAC\uD558\uACE0,
      \uC774\uC6C3\uACFC \uC774\uC57C\uAE30\uD558\uBA70 \uC601\uC5B4\uB97C \uC77C\uC0C1\uC73C\uB85C
      \uB9CC\uB4E4\uC5B4 \uBD10\uC694."
    task: 
    buttonLabel: "\uD568\uAED8 \uC2DC\uC791\uD558\uAE30"
  - step: 1
    title: "\uCCAB\uAC78\uC74C \uAC00\uC774\uB4DC 2/4 \xB7 \uC790\uC720\uB86D\uAC8C
      \uC774\uB3D9\uD558\uAE30"
    body: "WASD\uB85C \uAC77\uACE0 Shift\uB85C \uB2EC\uB824\uC694. \uB9C8\uC6B0\uC2A4
      \uC624\uB978\uCABD \uBC84\uD2BC\uC744 \uB204\uB978 \uCC44 \uC6C0\uC9C1\uC774\uBA74
      \uB458\uB7EC\uBCFC \uC218 \uC788\uC5B4\uC694."
    task: "WASD\uB85C \uD55C \uBC88 \uAC78\uC5B4 \uBCF4\uC138\uC694."
    buttonLabel: "\uC774\uD574\uD588\uC5B4\uC694"
  - step: 2
    title: "\uCCAB\uAC78\uC74C \uAC00\uC774\uB4DC 3/4 \xB7 \uC775\uC219\uD55C \uC0AC\uBB3C,
      \uC0C8\uB85C\uC6B4 \uC601\uC5B4"
    body: "\uAC00\uAD6C\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB9AC\uBA74 \uC601\uC5B4
      \uC774\uB984\uACFC \uB73B\uC774 \uB098\uC640\uC694. \uB300\uD654\uB098 \uD53C\uB4DC\uBC31\uC5D0\uC11C
      [\uD45C\uD604 \uC800\uC7A5]\uC744 \uB204\uB974\uBA74 \uC624\uB978\uCABD \uC704
      \uB2E8\uC5B4\uC7A5\uC5D0 \uBAA8\uC5EC\uC694."
    task: "\uBA48\uCD98 \uCC44 \uAC00\uAD6C\uC5D0 \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB824
      \uBCF4\uC138\uC694."
    buttonLabel: "\uB2E4\uC74C\uC73C\uB85C"
  - step: 3
    title: "\uCCAB\uAC78\uC74C \uAC00\uC774\uB4DC 4/4 \xB7 \uC774\uC81C, \uC774\uC6C3\uC744
      \uB9CC\uB098\uB7EC \uB098\uAC00\uC694"
    body: "\uBC16\uC5D0 \uB098\uAC00\uBA74 \uAE38\uC744 \uBB3B\uB294 \uC774\uC6C3\uC774
      \uB2E4\uAC00\uC640\uC694. \uD654\uBA74\uC5D0 \uB098\uC624\uB294 \uB300\uC0AC\uB97C
      \uC77D\uC73C\uBA70 \uAE38\uC744 \uC54C\uB824 \uC8FC\uACE0 \uB300\uD654 \uD654\uBA74\uC744
      \uC775\uD600\uC694."
    task: "\uBC29 \uB0A8\uCABD \uBB38\uC73C\uB85C \uB098\uAC00 \uBCF4\uC138\uC694."
    buttonLabel: 
  - step: 4
    title: "\uC774\uC6C3 \uB9CC\uB098\uAE30"
    body: "\uC774\uC6C3\uC774 \uAE38\uC744 \uBB3C\uC73C\uB7EC \uB2E4\uAC00\uC640\uC694.
      \uB9D0\uC744 \uAC78\uC5B4\uC624\uBA74 [\uB300\uD654\uD558\uAE30]\uB97C \uB20C\uB7EC\uC694."
    task: 
    buttonLabel: 
  - step: 6
    title: "\uCCAB \uBC88\uC9F8 \uB300\uD654, \uD574\uB0C8\uC5B4\uC694!"
    body: "\uD53C\uB4DC\uBC31\uC5D0\uC11C \uB2E4\uC74C \uB300\uD654\uC5D0 \uC4F8
      \uD45C\uD604\uC744 \uD655\uC778\uD558\uACE0 [\uD45C\uD604 \uC800\uC7A5]\uC73C\uB85C
      \uB2E8\uC5B4\uC7A5\uC5D0 \uBAA8\uC544 \uBCF4\uC138\uC694."
    task: "\uB2E4 \uBD24\uC73C\uBA74 \uD53C\uB4DC\uBC31\uC758 [\uB2EB\uAE30]\uB97C
      \uB20C\uB7EC\uC694."
    buttonLabel: 
  - step: 7
    title: "\uBBF8\uC158 \uC548\uB0B4 1/3 \xB7 \uBBF8\uC158 \uCC3D\uC744 \uBA3C\uC800
      \uC0B4\uD3B4\uBCFC\uAE4C\uC694?"
    body: "\uC67C\uCABD \uC704 \uBBF8\uC158 \uCC3D\uC5D0 \uC601\uC5B4\uB85C \uC5F0\uC2B5\uD560
      \uC791\uC740 \uBAA9\uD45C\uAC00 \uBCF4\uC5EC\uC694. \uBBF8\uC158\uC740 \uD55C
      \uBC88\uC5D0 \uD558\uB098\uC529 \uC9C4\uD589\uD574\uC694."
    task: 
    buttonLabel: "\uBBF8\uC158 \uCC3D \uD655\uC778\uD558\uAE30"
  - step: 8
    title: "\uBBF8\uC158 \uC548\uB0B4 2/3 \xB7 \uB9C8\uC74C\uC774 \uAC00\uB294 \uBBF8\uC158\uC744
      \uACE8\uB77C \uBCF4\uC138\uC694"
    body: "\uBBF8\uC158 \uCC3D\uC5D0\uC11C [\uBBF8\uC158 \uC2DC\uC791]\uC744 \uB20C\uB7EC
      \uD558\uB098\uB97C \uACE8\uB77C\uC694."
    task: 
    buttonLabel: 
  - step: 9
    title: "\uBBF8\uC158 \uC548\uB0B4 3/3 \xB7 NPC\uC640 \uB300\uD654\uD574 \uBCF4\uC138\uC694"
    body: "\uB9C8\uC744\uC758 CAFE \uAC74\uBB3C\uB85C \uB4E4\uC5B4\uAC00 \uCE74\uC6B4\uD130\uC758
      \uC9C1\uC6D0\uC5D0\uAC8C \uB2E4\uAC00\uAC00\uBA74 \uB9D0\uC744 \uAC78\uC5B4\uC640\uC694.
      \uBBF8\uC158 \uD0A4\uC6CC\uB4DC\uB97C \uB123\uC5B4 \uB9D0\uD574 \uBCF4\uC138\uC694."
    task: 
    buttonLabel: 
