  stepGuides:
  - step: 0
    title: "\uC5EC\uD589 \uCCAB\uB0A0"
    task: "\uC219\uC18C\uC5D0\uC11C \uAE30\uBCF8 \uC870\uC791\uBD80\uD130 \uC775\uD600
      \uBCFC\uAE4C\uC694?"
    touchTask: 
    buttonLabel: "\uC2DC\uC791\uD558\uAE30"
  - step: 1
    title: "\uAC77\uAE30"
    task: "{WASD} \uAC77\uAE30 \xB7 {Shift} \uB6F0\uAE30 \xB7 {\uC2A4\uD398\uC774\uC2A4}
      \uC810\uD504"
    touchTask: "\uC67C\uCABD \uC544\uB798 {\uC870\uC774\uC2A4\uD2F1}\uC744 \uBC00\uC5B4
      \uAC77\uAE30"
    buttonLabel: 
  - step: 2
    title: "\uB458\uB7EC\uBCF4\uAE30"
    task: "{\uB9C8\uC6B0\uC2A4 \uC67C\uCABD} \uB204\uB978 \uCC44 \uB04C\uAE30 \xB7
      {\uD720} \uC90C \xB7 {V} \uC2DC\uC810"
    touchTask: "\uD654\uBA74 \uC624\uB978\uCABD\uC744 \uB04C\uC5B4 \uB458\uB7EC\uBCF4\uAE30"
    buttonLabel: 
  - step: 3
    title: "\uB2E8\uC5B4 \uBAA8\uC73C\uAE30"
    task: "\uAC00\uAD6C\uB97C \uD074\uB9AD\uD574 \uCE74\uB4DC \uACE0\uC815 \u2192
      {\uC800\uC7A5}"
    touchTask: "\uAC00\uAD6C\uB97C \uB20C\uB7EC \uCE74\uB4DC \uACE0\uC815 \u2192
      {\uC800\uC7A5}"
    buttonLabel: 
  - step: 4
    title: "\uB2E8\uC5B4\uC7A5"
    task: "{\u2261} \uBA54\uB274\uC5D0\uC11C {\uB2E8\uC5B4\uC7A5} \uC5F4\uAE30"
    touchTask: 
    buttonLabel: 
  - step: 5
    title: "\uBC16\uC73C\uB85C"
    task: "\uD654\uC0B4\uD45C\uAC00 \uAC00\uB9AC\uD0A4\uB294 \uBB38\uC73C\uB85C \uB098\uAC00\uAE30"
    touchTask: 
    buttonLabel: 
  - step: 6
    title: "Ben \uB9CC\uB098\uAE30"
    task: "\uAE38\uC744 \uD5E4\uB9E4\uB294 Ben\uC774 \uB2E4\uAC00\uC624\uBA74 {\uB300\uD654\uD558\uAE30}"
    touchTask: 
    buttonLabel: 
  - step: 8
    title: "\uD53C\uB4DC\uBC31"
    task: "\uD53C\uB4DC\uBC31\uC744 \uC77D\uACE0 {X}\uB85C \uB2EB\uAE30"
    touchTask: 
    buttonLabel: 
  - step: 9
    title: "\uC624\uB298\uC758 \uBAA9\uD45C"
    task: "{\uC9C0\uB3C4} \uBC84\uD2BC\uC73C\uB85C \uC624\uB298\uC758 \uBAA9\uD45C
      \uBCF4\uAE30"
    touchTask: 
    buttonLabel: 
  talkOfferCaption: "{\uB300\uD654\uD558\uAE30}\uB97C \uB20C\uB7EC Ben\uACFC \uC774\uC57C\uAE30\uD574\uC694"
  dialogueLinesCaption: "Ben\uC774 \uBA3C\uC800 \uB9D0\uC744 \uAC78\uC5C8\uC5B4\uC694.
    \uC8FC\uACE0\uBC1B\uC740 \uB300\uD654\uB294 \uC5EC\uAE30\uC5D0 \uC313\uC5EC\uC694"
  dialogueToolsCaption: "Ben\uC758 \uB9D0\uC774 \uC5B4\uB824\uC6B0\uBA74 {\uB73B}\uC73C\uB85C
    \uD55C\uAD6D\uC5B4 \uB73B\uC744 \uBD10\uC694. {\uC608\uC2DC \uBB38\uC7A5}\uC740
    \uD560 \uB9D0\uC744 \uC785\uB825\uCE78\uC5D0 \uCC44\uC6CC \uC918\uC694"
  suggestedWordsCaption: "{\uB2E8\uC5B4}\uC5D0\uB294 \uB300\uB2F5\uC5D0 \uC4F8 \uB9CC\uD55C
    \uCD94\uCC9C \uB2E8\uC5B4\uAC00 \uB098\uC640\uC694"
  suggestedSentenceCaption: "{\uBB38\uC7A5}\uC740 \uC9C0\uAE08 \uD558\uBA74 \uC88B\uC740
    \uCD94\uCC9C \uBB38\uC7A5\uC774\uC5D0\uC694. {\uB123\uAE30}\uB97C \uB204\uB974\uBA74
    \uC785\uB825\uCE78\uC5D0 \uCC44\uC6CC\uC838\uC694"
  guidedLineCaption: "\uD29C\uD1A0\uB9AC\uC5BC\uC740 \uC815\uD574\uC9C4 \uD750\uB984\uB300\uB85C
    \uC9C4\uD589\uB3FC\uC694. \uC774 \uB300\uC0AC\uB97C {\uAFB9 \uB20C\uB7EC \uB9D0\uD558\uAE30}\uB85C
    \uB9D0\uD558\uAC70\uB098 \uC785\uB825\uD558\uACE0 {\uBCF4\uB0B4\uAE30}"
  guidedLineMissCaption: "\uD29C\uD1A0\uB9AC\uC5BC\uC740 \uC815\uD574\uC9C4 \uD750\uB984\uB300\uB85C
    \uC9C4\uD589\uB3FC\uC694. \uC774 \uB300\uC0AC\uC640 \uAC19\uAC8C \uC785\uB825\uD558\uAC70\uB098
    {\uC608\uC2DC \uBB38\uC7A5}\uC73C\uB85C \uCC44\uC6CC\uC694"
  dialogueEndCaption: "\uAE38 \uC548\uB0B4\uB97C \uB9C8\uCCE4\uC5B4\uC694! {\uB300\uD654
    \uC885\uB8CC}\uB97C \uB204\uB974\uBA74 Ben\uACFC \uB098\uB208 \uB300\uD654\uB97C
    \uB3CC\uC544\uBCF4\uB294 \uD53C\uB4DC\uBC31\uC744 \uBCFC \uC218 \uC788\uC5B4\uC694"
  feedbackSectionsCaption: "Ben\uACFC \uB098\uB208 \uB300\uD654\uB97C \uB3CC\uC544\uBCF4\uB294
    \uB300\uD654 \uB178\uD2B8\uC608\uC694. \uD0ED\uC744 \uB20C\uB7EC {\uC694\uC57D}\xB7{\uBB38\uC7A5}\xB7{\uD68C\uD654}\xB7{\uD45C\uD604}\uC744
    \uBD10\uC694"
  feedbackPagesCaption: "\uB0B4\uC6A9\uC774 \uAE38\uBA74 \uC544\uB798 \uD654\uC0B4\uD45C\uB85C
    \uB2E4\uC74C \uC7A5\uC744 \uB118\uACA8 \uBD10\uC694"
  feedbackCloseCaption: "\uB2E4 \uBD24\uC73C\uBA74 \uC624\uB978\uCABD \uC704 {X}\uB85C
    \uB2EB\uC544\uC694. \uC774\uC5B4\uC11C \uC624\uB298\uC758 \uBAA9\uD45C\uB97C
    \uC54C\uB824 \uB4DC\uB824\uC694"
  vocabularyCaption: "\uB2E8\uC5B4\uC7A5\uC5D0\uB294 \uC0AC\uBB3C \uCE74\uB4DC\uC5D0\uC11C
    {\uC800\uC7A5}\uD55C \uB2E8\uC5B4\uAC00 \uBAA8\uC5EC\uC694. \uB73B\xB7\uC608\uBB38\uC744
    \uB2E4\uC2DC \uBCF4\uACE0 {\uC678\uC6E0\uC5B4\uC694}\xB7\uBA54\uBAA8\uB85C \uC815\uB9AC\uD574\uC694\n\uB2E4
    \uBD24\uC73C\uBA74 \uC624\uB978\uCABD \uC704 {X}\uB85C \uB2EB\uACE0 \uBC16\uC73C\uB85C
    \uB098\uAC00\uC694"
  travelLockedMessage: "\uC544\uC9C1 \uB2E4\uB978 \uACF3\uC73C\uB85C \uAC08 \uC218
    \uC5C6\uC5B4\uC694. \uD560 \uC77C\uBD80\uD130 \uD574 \uC8FC\uC138\uC694."
