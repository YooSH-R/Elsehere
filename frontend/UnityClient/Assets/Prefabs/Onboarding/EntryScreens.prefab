    \uB300\uD654\uC640 \uC800\uC7A5\uD55C \uB2E8\uC5B4, NPC\uC640\uC758 \uC0AC\uC774\uB97C
    \uADF8\uB300\uB85C \uC774\uC5B4 \uAC08 \uC218 \uC788\uC5B4\uC694.\n\uAC8C\uC2A4\uD2B8\uB294
    2\uC2DC\uAC04 \uB3D9\uC548 \uC811\uC18D\uD558\uC9C0 \uC54A\uC73C\uBA74 \uB2E4\uC2DC
    \uB4E4\uC5B4\uC62C \uC218 \uC5C6\uC5B4\uC694."
