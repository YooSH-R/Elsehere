# Real secrets belong in ~/apps/a305/dev/deploy.env on the server.
BACKEND_HOST_PORT=8081
DB_NAME=a305_dev
DB_USERNAME=a305_dev
DB_PASSWORD=
JPA_DDL_AUTO=validate
# Backend log level for com.elsehere (libraries stay at INFO). Development shows DEBUG logs.
BACKEND_LOG_LEVEL=DEBUG
# Backend log file format in the backend-logs volume. Empty keeps readable text lines for development.
BACKEND_LOG_FILE_FORMAT=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_WORKER_TOKEN=
LLM_PROFILE=gms-luna
GMS_KEY=
GROQ_API_KEY=
# Optional: STT via the GPU server tunnel, e.g. STT_CHAIN=gpu:turbo-lr1e4,gms:whisper-1,groq:whisper-large-v3-turbo
STT_CHAIN=
STT_GPU_BASE_URL=
STT_GPU_TOKEN=
STT_FIRST_TIMEOUT_S=
# Optional: rudeness judge via the GPU server tunnel (vLLM), e.g. GUARD_GPU_MODEL=guard-qwen3.8-27b-r16
GUARD_GPU_MODEL=
GUARD_GPU_BASE_URL=
GUARD_GPU_TOKEN=
# Optional: speech synthesis via the GPU server tunnel, e.g. TTS_GPU_BASE_URL=http://172.19.0.1:18433
TTS_GPU_BASE_URL=
TTS_GPU_TOKEN=
# Build jobs supply immutable image references separately from these secrets.
BACKEND_IMAGE=
AI_IMAGE=
WEB_IMAGE=

# Kokoro CPU synthesis and phoneme timing (app Compose defaults).
AI_WORKER_CPUS=2.0
AI_WORKER_MEMORY=1g
TTS_CHUNK_BUDGET_S=8
TTS_FULL_BUDGET_S=6
