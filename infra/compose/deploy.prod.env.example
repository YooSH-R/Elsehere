# Production activation requires a reviewed release and prepared database schema.
BACKEND_HOST_PORT=8080
DB_NAME=a305_prod
DB_USERNAME=a305_prod
DB_PASSWORD=
JPA_DDL_AUTO=validate
# Backend log level for com.elsehere (libraries stay at INFO). Production keeps INFO.
BACKEND_LOG_LEVEL=INFO
# Backend log file format in the backend-logs volume. Production writes one ECS JSON object per line.
BACKEND_LOG_FILE_FORMAT=ecs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_WORKER_TOKEN=
LLM_PROFILE=gms-luna
GMS_KEY=
GROQ_API_KEY=
BACKEND_IMAGE=
AI_IMAGE=
WEB_IMAGE=

# Optional GPU server tunnels; they reach only the fixed prod worker (compose.prod-worker-network.yaml).
# Tokens are the same as dev because one GPU server process serves both environments.
# Optional: STT via the GPU server tunnel, e.g. STT_CHAIN=gpu:turbo-lr1e4,gms:whisper-1,groq:whisper-large-v3-turbo
STT_CHAIN=
STT_GPU_BASE_URL=
STT_GPU_TOKEN=
STT_FIRST_TIMEOUT_S=
# Optional: rudeness judge via the GPU server tunnel (vLLM), e.g. GUARD_GPU_BASE_URL=http://172.30.0.1:18432/v1
GUARD_GPU_MODEL=
GUARD_GPU_BASE_URL=
GUARD_GPU_TOKEN=
# Optional: speech synthesis via the GPU server tunnel, e.g. TTS_GPU_BASE_URL=http://172.30.0.1:18433
TTS_GPU_BASE_URL=
TTS_GPU_TOKEN=

# Kokoro CPU synthesis and phoneme timing (app Compose defaults).
AI_WORKER_CPUS=2.0
AI_WORKER_MEMORY=1g
TTS_CHUNK_BUDGET_S=8
