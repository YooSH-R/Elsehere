# Production activation requires a reviewed release and prepared database schema.
BACKEND_HOST_PORT=8080
DB_NAME=a305_prod
DB_USERNAME=a305_prod
DB_PASSWORD=
JPA_DDL_AUTO=validate
# Backend log level for com.elsehere (libraries stay at INFO). Production keeps INFO.
BACKEND_LOG_LEVEL=INFO
# Backend log file format in the backend-logs volume. Production writes one ECS JSON object per line.
BACKEND_LOG_FILE_FORMAT=ecs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=
AI_WORKER_TOKEN=
LLM_PROFILE=gms-luna
GMS_KEY=
GROQ_API_KEY=
# Shared GPU services use the production tunnel gateway. Fill tokens from the server's dev settings.
# GPU tokens are shared with dev; AI_WORKER_TOKEN remains environment-specific.
STT_CHAIN=gpu:turbo-lr1e4,gms:whisper-1,groq:whisper-large-v3-turbo
STT_GPU_BASE_URL=http://172.30.0.1:18431/v1
# Backup GPU (gpu_backup in STT_CHAIN, http://172.30.0.1:18441/v1) stays empty until the privacy policy lists that GPU.
STT_GPU_BACKUP_BASE_URL=
STT_GPU_TOKEN=
STT_FIRST_TIMEOUT_S=3
GUARD_GPU_MODEL=guard-qwen3.8-27b-r16
GUARD_GPU_BASE_URL=http://172.30.0.1:18432/v1
GUARD_GPU_TOKEN=
# Intent judge on the GPU server stays off in prod until the dev measurement is done.
JUDGE_GPU_MODEL=
TTS_GPU_BASE_URL=http://172.30.0.1:18433
# Backup GPU synthesis (http://172.30.0.1:18443) follows the same privacy policy condition as the STT backup.
TTS_GPU_BACKUP_BASE_URL=
TTS_GPU_TOKEN=
BACKEND_IMAGE=
AI_IMAGE=
WEB_IMAGE=

# Kokoro CPU synthesis and phoneme timing (app Compose defaults).
AI_WORKER_CPUS=2.0
AI_WORKER_MEMORY=1g
TTS_CHUNK_BUDGET_S=8
TTS_FULL_BUDGET_S=6
