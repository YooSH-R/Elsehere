{
  "uid": "a305-api",
  "title": "ELSEHERE API",
  "tags": ["a305", "api"],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [{
      "name": "environment", "label": "환경", "type": "query",
      "datasource": {"type": "prometheus", "uid": "a305-prometheus"},
      "query": "label_values(up{job=~\"elsehere-api.*\"}, environment)",
      "refresh": 1, "includeAll": true, "allValue": ".*", "multi": true,
      "current": {"text": "All", "value": "$__all"}
    }]
  },
  "panels": [
    {
      "id": 1, "title": "API 지표 수집 상태", "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 5},
      "datasource": {"type": "prometheus", "uid": "a305-prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=~\"elsehere-api.*\",environment=~\"$environment\"}", "legendFormat": "{{environment}}"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "수집 실패"}, "1": {"text": "정상"}}}]}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2, "title": "선택 기간 API 요청 수", "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 5},
      "datasource": {"type": "prometheus", "uid": "a305-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (environment) (increase(http_server_requests_seconds_count{job=~\"elsehere-api.*\",environment=~\"$environment\"}[$__range]))", "legendFormat": "{{environment}}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3, "title": "API 요청량 / 초", "type": "timeseries",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 5},
      "datasource": {"type": "prometheus", "uid": "a305-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (environment) (rate(http_server_requests_seconds_count{job=~\"elsehere-api.*\",environment=~\"$environment\"}[$__rate_interval]))", "legendFormat": "{{environment}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []}
    },
    {
      "id": 4, "title": "4xx 요청 비율", "type": "timeseries",
      "gridPos": {"x": 0, "y": 5, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "a305-prometheus"},
      "targets": [{"refId": "A", "expr": "(sum by (environment) (rate(http_server_requests_seconds_count{job=~\"elsehere-api.*\",environment=~\"$environment\",status=~\"4..\"}[$__rate_interval])) or on (environment) (0 * sum by (environment) (rate(http_server_requests_seconds_count{job=~\"elsehere-api.*\",environment=~\"$environment\"}[$__rate_interval])))) / clamp_min(sum by (environment) (rate(http_server_requests_seconds_count{job=~\"elsehere-api.*\",environment=~\"$environment\"}[$__rate_interval])), 1e-9)", "legendFormat": "{{environment}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 5, "title": "5xx 요청 비율", "type": "timeseries",
      "gridPos": {"x": 8, "y": 5, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "a305-prometheus"},
      "targets": [{"refId": "A", "expr": "(sum by (environment) (rate(http_server_requests_seconds_count{job=~\"elsehere-api.*\",environment=~\"$environment\",status=~\"5..\"}[$__rate_interval])) or on (environment) (0 * sum by (environment) (rate(http_server_requests_seconds_count{job=~\"elsehere-api.*\",environment=~\"$environment\"}[$__rate_interval])))) / clamp_min(sum by (environment) (rate(http_server_requests_seconds_count{job=~\"elsehere-api.*\",environment=~\"$environment\"}[$__rate_interval])), 1e-9)", "legendFormat": "{{environment}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 6, "title": "API p95 응답 시간", "type": "timeseries",
      "gridPos": {"x": 16, "y": 5, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "a305-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, environment) (rate(http_server_requests_seconds_bucket{job=~\"elsehere-api.*\",environment=~\"$environment\"}[$__rate_interval])))", "legendFormat": "{{environment}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    }
  ]
}
