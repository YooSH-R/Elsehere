{
  "uid": "a305-runners",
  "title": "ELSEHERE CI Runners",
  "description": "EC2·노트북 Linux·노트북 Unity 러너의 연결 상태와 현재 작업. 15초 간격으로 갱신되며 GitLab 상태 반영 지연이 있습니다.",
  "tags": [
    "a305",
    "gitlab",
    "runners"
  ],
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "장비",
        "type": "custom",
        "query": "EC2,노트북,팀원 Unity,미분류",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "EC2",
            "value": "EC2",
            "selected": false
          },
          {
            "text": "노트북",
            "value": "노트북",
            "selected": false
          },
          {
            "text": "팀원 Unity",
            "value": "팀원 Unity",
            "selected": false
          },
          {
            "text": "미분류",
            "value": "미분류",
            "selected": false
          }
        ]
      }
    ]
  },
  "links": [
    {
      "title": "GitLab 러너 관리",
      "type": "link",
      "url": "https://lab.ssafy.com/s15-final/S15P31A305/-/settings/ci_cd#js-runners-settings",
      "targetBlank": true
    },
    {
      "title": "GitLab 전체 작업",
      "type": "link",
      "url": "https://lab.ssafy.com/s15-final/S15P31A305/-/jobs",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "GitLab 수집 상태",
      "description": "미연결·실패이면 실행 목록과 0개 표시를 정상 대기로 해석하지 마세요.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "a305-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"gitlab-runners\"} * on (instance) a305_gitlab_scrape_success{job=\"gitlab-runners\"}) or vector(0)",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "수집 없음",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "미연결 / 조회 실패",
                  "color": "red"
                },
                "1": {
                  "text": "정상",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "EC2 실행 중",
      "description": "GitLab의 running·preparing·canceling 작업 수입니다.",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "a305-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(a305_gitlab_runner_running_jobs{job=\"gitlab-runners\",host=\"EC2\"})",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "수집 없음",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "팀원 실행 중",
      "description": "팀원의 CI와 Unity 러너에서 실행 중인 작업의 합계입니다.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "a305-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(a305_gitlab_runner_running_jobs{job=\"gitlab-runners\",host=~\"팀원 CI|팀원 Unity\"})",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "수집 없음",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "프로젝트 대기 작업",
      "description": "pending·waiting_for_resource 작업 수입니다. 러너 배정 전에는 특정 장비의 대기열로 구분할 수 없습니다.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "a305-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "a305_gitlab_pending_jobs{job=\"gitlab-runners\"}",
          "instant": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "수집 없음",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "러너별 실행 작업 수",
      "description": "0은 작업 대기 상태입니다. 연결·일시중지 여부는 아래 러너 연결 상태를 확인하세요.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "a305-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "a305_gitlab_runner_running_jobs{job=\"gitlab-runners\",host=~\"$host\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{host}} · {{runner}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "수집 없음",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 6,
      "title": "지금 실행 중인 작업",
      "description": "GitLab에서 현재 실행·준비·취소 처리 중인 작업입니다. 로그 번호를 누르면 GitLab 작업 로그가 열립니다. 수집 정상 상태에서 목록이 비면 실행 작업이 없습니다.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "a305-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "a305_gitlab_job_elapsed_seconds{job=\"gitlab-runners\",host=~\"$host\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "runner_id": true,
              "job_url": true
            },
            "indexByName": {
              "host": 0,
              "runner": 1,
              "job_name": 2,
              "ref": 3,
              "status": 4,
              "Value": 5,
              "pipeline_id": 6,
              "job_id": 7,
              "stage": 8
            },
            "renameByName": {
              "host": "장비",
              "runner": "러너",
              "job_name": "작업",
              "ref": "브랜치",
              "status": "상태",
              "Value": "경과 시간",
              "pipeline_id": "파이프라인",
              "job_id": "로그",
              "stage": "단계"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "경과 시간"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "로그"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "GitLab 작업 로그",
                    "url": "https://lab.ssafy.com/s15-final/S15P31A305/-/jobs/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "상태"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "running": {
                        "text": "실행 중"
                      },
                      "preparing": {
                        "text": "준비 중"
                      },
                      "canceling": {
                        "text": "취소 처리 중"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "경과 시간",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 7,
      "title": "러너 연결 상태",
      "description": "Online은 최근 GitLab 통신 상태이며 실제 작업 실행 여부와 다릅니다. 노트북 종료가 GitLab 연결 상태에 반영되기까지 지연이 있을 수 있습니다. 미분류 러너는 runner-hosts.json에 설명과 장비를 등록하세요.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "a305-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "a305_gitlab_runner_info{job=\"gitlab-runners\",host=~\"$host\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "Value": true
            },
            "indexByName": {
              "host": 0,
              "runner": 1,
              "runner_id": 2,
              "status": 3,
              "paused": 4
            },
            "renameByName": {
              "host": "장비",
              "runner": "러너",
              "runner_id": "Runner ID",
              "status": "GitLab 연결",
              "paused": "작업 수신"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "GitLab 연결"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "online": {
                        "text": "온라인",
                        "color": "green"
                      },
                      "offline": {
                        "text": "오프라인",
                        "color": "red"
                      },
                      "stale": {
                        "text": "장기 미접속",
                        "color": "orange"
                      },
                      "never_contacted": {
                        "text": "미연결",
                        "color": "gray"
                      },
                      "unknown": {
                        "text": "확인 필요",
                        "color": "orange"
                      },
                      "paused": {
                        "text": "일시중지",
                        "color": "orange"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "작업 수신"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "일시중지",
                        "color": "orange"
                      },
                      "false": {
                        "text": "활성",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ]
}
